      url: "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQEm_iJyZaxOcgRU6A74TLG1avC-vFLwo6pEfremAgpXJytmaQaZkpzpSwV_6DWRS97D1f58HDMlc6cW1wDnFREew4rBW3nMf45BhyRS4_L6fdTFkOfja2uAB91c9Qgqzw6h6pnIhWmwzdOk"
      title: "netexplanations.com"
