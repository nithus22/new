es\',\\n    hindi: \'\340\244\246\340\245\202\340\244\260\',\\n    english: \'Far\',\\n    santali: {\\n      olchiki: \'\341\261\245\341\261\237\341\261\272\341\261\234\341\261\244\341\261\247\',\\n      roman: \'Sangin\',\\n      audioHint: \'Sangin\',\\n    },\\n    ho: {\\n      warangchiti: \'\360\221\242\267\360\221\243\201\360\221\243\212\360\221\243\202\360\221\243\235\',\\n      devanagari: \'\340\244\270\340\244\276\340\244\202\340\244\227\340\244\277\340\244\250\',\\n      roman: \'Sangin\',\\n      audioHint: \'Sangin\',\\n    },\\n    mundari: {\\n      devanagari: \'\340\244\270\340\244\276\340\244\202\340\244\227\340\244\277\340\244\250\',\\n      roman: \'Sangin\',\\n      audioHint: \'Sangin\',\\n    },\\n  },\\n  {\\n    id: \'rolling\',\\n    category: \'shapes\',\\n    hindi: \'\340\244\262\340\245\201\340\244\242\340\244\274\340\244\225\340\244\250\340\244\276\',\\n    english: \'Rolling\',\\n    santali: {\\n      olchiki: \'\341\261\234\341\261\251\341\261\260\341\261\250\341\261\237\341\261\271\341\261\243\',\\n      roman: \'Gudrau\',\\n      audioHint: \'Gudrau\',\\n    },\\n    ho: {\\n      warangchiti: \'\360\221\242\236\360\221\243\203\360\221\243\221\360\221\243\203\360\221\243\234\',\\n      devanagari: \'\340\244\227\340\245\201\340\244\241\340\245\201\340\244\260\',\\n      roman: \'Gudur\',\\n      audioHint: \'Gudur\',\\n    },\\n    mundari: {\\n      devanagari: \'\340\244\227\340\245\201\340\244\262\340\244\227\340\245\201\340\244\262\',\\n      roman: \'Gulgul\',\\n      audioHint: \'Gulgul\',\\n    },\\n  },\\n  {\\n    id: \'sliding\',\\n    category: \'shapes\',\\n    hindi: \'\340\244\226\340\244\277\340\244\270\340\244\225\340\244\250\340\244\276\',\\n    english: \'Sliding\',\\n    santali: {\\n      olchiki: \'\341\261\245\341\261\244\341\261\253\341\261\251\341\261\262\',\\n      roman: \'Sidur / Sarse\',\\n      audioHint: \'Sidur\',\\n    },\\n    ho: {\\n      warangchiti: \'\360\221\242\267\360\221\243\202\360\221\243\234\360\221\243\236\360\221\243\201\',\\n      devanagari: \'\340\244\270\340\244\277\340\244\260\340\244\270\340\244\276\',\\n      roman: \'Sirsa\',\\n      audioHint: \'Sirsa\',\\n    },\\n    mundari: {\\n      devanagari: \'\340\244\260\340\245\207\340\244\202\340\244\227\340\244\241\340\244\274\340\244\276\',\\n      roman: \'Rengda\',\\n      audioHint: \'Rengda\',\\n    },\\n  },\\n  // Numbers (1 to 5)\\n  {\\n    id: \'one\',\\n    category: \'numbers\',\\n    hindi: \'\340\244\217\340\244\225\',\\n    english: \'One (1)\',\\n    santali: {\\n      olchiki: \'\341\261\242\341\261\244\341\261\253\',\\n      roman: \'Mit\',\\n      audioHint: \'Mit\',\\n    },\\n    ho: {\\n      warangchiti: \'\360\221\242\255\360\221\243\202\360\221\243\201\',\\n      devanagari: \'\340\244\256\340\244\277\340\244\257\340\244\276\340\244\246\',\\n      roman: \'Miyad\',\\n      audioHint: \'Miyad\',\\n    },\\n    mundari: {\\n      devanagari: \'\340\244\256\340\244\277\340\244\257\340\244\276\340\244\246\',\\n      roman: \'Miyad\',\\n      audioHint: \'Miyad\',\\n    },\\n  },\\n  {\\n    id: \'two\',\\n    category: \'numbers\',\\n    hindi: \'\340\244\246\340\245\213\',\\n    english: \'Two (2)\',\\n    santali: {\\n      olchiki: \'\341\261\265\341\261\237\341\261\250\',\\n      roman: \'Bar\',\\n      audioHint: \'Bar\',\\n    },\\n    ho: {\\n      warangchiti: \'\360\221\242\252\360\221\243\201\360\221\243\234\360\221\243\202\360\221\243\201\',\\n      devanagari: \'\340\244\254\340\244\276\340\244\260\340\244\277\340\244\257\340\244\276\',\\n      roman: \'Bariya\',\\n      audioHint: \'Bariya\',\\n    },\\n    mundari: {\\n      devanagari: \'\340\244\254\340\244\276\340\244\260\340\244\277\340\244\257\340\244\276\',\\n      roman: \'Bariya\',\\n      audioHint: \'Bariya\',\\n    },\\n  },\\n  {\\n    id: \'three\',\\n    category: \'numbers\',\\n    hindi: \'\340\244\244\340\245\200\340\244\250\',\\n    english: \'Three (3)\',\\n    santali: {\\n      olchiki: \'\341\261\257\341\261\256\',\\n      roman: \'Pe\',\\n      audioHint: \'Pe\',\\n    },\\n    ho: {\\n      warangchiti: \'\360\221\242\240\360\221\243\202\360\221\243\201\',\\n      devanagari: \'\340\244\205\340\244\252\340\244\277\340\244\257\340\244\276\',\\n      roman: \'Apiya\',\\n      audioHint: \'Apiya\',\\n    },\\n    mundari: {\\n      devanagari: \'\340\244\205\340\244\252\340\244\277\340\244\257\340\244\276\',\\n      roman: \'Apiya\',\\n      audioHint: \'Apiya\',\\n    },\\n  },\\n  {\\n    id: \'four\',\\n    category: \'numbers\',\\n    hindi: \'\340\244\232\340\244\276\340\244\260\',\\n    english: \'Four (4)\',\\n    santali: {\\n      olchiki: \'\341\261\257\341\261\263\341\261\261\',\\n      roman: \'Pon\',\\n      audioHint: \'Pon\',\\n    },\\n    ho: {\\n      warangchiti: \'\360\221\242\241\360\221\243\203\360\221\243\205\360\221\243\202\360\221\243\201\',\\n      devanagari: \'\340\244\211\340\244\252\340\245\201\340\244\250\340\244\277\340\244\257\340\244\276\',\\n      roman: \'Upuniya\',\\n      audioHint: \'Upuniya\',\\n    },\\n    mundari: {\\n      devanagari: \'\340\244\211\340\244\252\340\245\201\340\244\250\340\244\277\340\244\257\340\244\276\',\\n      roman: \'Upuniya\',\\n      audioHint: \'Upuniya\',\\n    },\\n  },\\n  {\\n    id: \'five\',\\n    category: \'numbers\',\\n    hindi: \'\340\244\252\340\244\276\340\244\201\340\244\232\',\\n    english: \'Five (5)\',\\n    santali: {\\n      olchiki: \'\341\261\242\341\261\232\341\261\254\341\261\256\',\\n      roman: \'More\',\\n      audioHint: \'More\',\\n    },\\n    ho: {\\n      warangchiti: \'\360\221\242\255\360\221\243\211\360\221\243\216\360\221\243\202\360\221\243\201\',\\n      devanagari: \'\340\244\256\340\245\213\340\244\241\340\244\274\340\245\207\340\244\257\340\244\276\',\\n      roman: \'Modeya\',\\n      audioHint: \'Modeya\',\\n    },\\n    mundari: {\\n      devanagari: \'\340\244\256\340\245\213\340\244\241\340\244\274\340\245\207\340\244\257\340\244\276\',\\n      roman: \'Modeya\',\\n      audioHint: \'Modeya\',\\n    },\\n  },\\n  // Forest & Animals (Jharkhand Nature)\\n  {\\n    id: \'tree\',\\n    category: \'nature\',\\n    hindi: \'\340\244\252\340\245\207\340\244\241\340\244\274 / \340\244\270\340\244\276\340\244\262 \340\244\265\340\245\203\340\244\225\340\245\215\340\244\267\',\\n    english: \'Tree / Sal Tree\',\\n    santali: {\\n      olchiki: \'\341\261\253\341\261\237\341\261\250\341\261\256\',\\n      roman: \'Dare (Sarjom dare)\',\\n      audioHint: \'Dare\',\\n    },\\n    ho: {\\n      warangchiti: \'\360\221\242\241\360\221\243\202\360\221\243\234\360\221\243\203\',\\n      devanagari: \'\340\244\246\340\244\276\340\244\260\340\245\202 (\340\244\270\340\244\260\340\244\234\340\245\213\340\244\256 \340\244\246\340\244\276\340\244\260\340\245\202)\',\\n      roman: \'Daru\',\\n      audioHint: \'Daru\',\\n    },\\n    mundari: {\\n      devanagari: \'\340\244\246\340\244\276\340\244\260\340\245\202\',\\n      roman: \'Daru\',\\n      audioHint: \'Daru\',\\n    },\\n  },\\n  {\\n    id: \'deer\',\\n    category: \'nature\',\\n    hindi: \'\340\244\271\340\244\277\340\244\260\340\244\243 (\340\244\233\340\245\213\340\244\237\340\245\202)\',\\n    english: \'Deer (Chotu)\',\\n    santali: {\\n      olchiki: \'\341\261\241\341\261\244\341\261\236\',\\n      roman: \'Jil (Hiran)\',\\n      audioHint: \'Jil\',\\n    },\\n    ho: {\\n      warangchiti: \'\360\221\242\216\360\221\243\202\360\221\243\241\',\\n      devanagari: \'\340\244\234\340\244\277\340\244\262\',\\n      roman: \'Jil\',\\n      audioHint: \'Jil\',\\n    },\\n    mundari: {\\n      devanagari: \'\340\244\234\340\244\277\340\244\262\',\\n      roman: \'Jil\',\\n      audioHint: \'Jil\',\\n    },\\n  },\\n  {\\n    id: \'elephant\',\\n    category: \'nature\',\\n    hindi: \'\340\244\271\340\244\276\340\244\245\340\245\200\',\\n    english: \'Elephant\',\\n    santali: {\\n      olchiki: \'\341\261\246\341\261\237\341\261\271\341\261\233\341\261\244\',\\n      roman: \'Hati\',\\n      audioHint: \'Hati\',\\n    },\\n    ho: {\\n      warangchiti: \'\360\221\242\271\360\221\243\201\360\221\243\225\360\221\243\202\',\\n      devanagari: \'\340\244\271\340\244\276\340\244\244\340\245\200\',\\n      roman: \'Hati\',\\n      audioHint: \'Hati\',\\n    },\\n    mundari: {\\n      devanagari: \'\340\244\271\340\244\276\340\244\244\340\245\200\',\\n      roman: \'Hati\',\\n      audioHint: \'Hati\',\\n    },\\n  },\\n  {\\n    id: \'water\',\\n    category: \'nature\',\\n    hindi: \'\340\244\252\340\244\276\340\244\250\340\245\200\',\\n    english: \'Water\',\\n    santali: {\\n      olchiki: \'\341\261\253\341\261\237\341\261\234\',\\n      roman: \'Dah (Dag)\',\\n      audioHint: \'Dag\',\\n    },\\n    ho: {\\n      warangchiti: \'\360\221\242\241\360\221\243\201\360\221\243\200\',\\n      devanagari: \'\340\244\246\340\244\276\340\244\203\',\\n      roman: \'Da:\',\\n      audioHint: \'Dah\',\\n    },\\n    mundari: {\\n      devanagari: \'\340\244\246\340\244\276\340\244\203\',\\n      roman: \'Da:\',\\n      audioHint: \'Dah\',\\n    },\\n  },\\n];\\n\\nexport function lookupTerm(wordOrId: string, lang: LanguageId) {\\n  const term = SCHOOL_GLOSSARY.find(\\n    t => t.id === wordOrId || t.hindi.toLowerCase().includes(wordOrId.toLowerCase()) || t.english.toLowerCase() === wordOrId.toLowerCase()\\n  );\\n  if (!term) return null;\\n  if (lang === \'santali\') return term.santali;\\n  if (lang === \'ho\') return term.ho;\\n  if (lang === \'mundari\') return term.mundari;\\n  return null;\\n}\\n\",\"Description\":\"Create Jharkhand school-term multilingual glossary for Santali, Ho, Mundari, Hindi, and English\",\"Overwrite\":true,\"TargetFile\":\"/src/data/glossary.ts\",\"toolAction\":\"Creating glossary.ts\",\"toolSummary\":\"Create school glossary\"}"
