  planner_response {
    thinking: "**Defining Glossary Content**\n\nI am now focused on defining the content of `src/data/glossary.ts`. My key goal is to create a comprehensive school-term glossary specifically for Jharkhand primary schools. This glossary will be multilingual, covering Santali, Ho, Mundari, Hindi, and English. Recognizing the limited AI resources for Ho and Mundari, this will require some additional consideration.\n\n\n"
    tool_calls {
      id: "call_130172"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { LanguageId } from \'../types\';\\n\\nexport interface GlossaryTerm {\\n  id: string;\\n  category: \'shapes\' | \'numbers\' | \'classroom\' | \'nature\' | \'relations\' | \'actions\';\\n  hindi: string;\\n  english: string;\\n  santali: {\\n    olchiki: string;\\n    roman: string;\\n    audioHint: string;\\n  };\\n  ho: {\\n    warangchiti: string;\\n    devanagari: string;\\n    roman: string;\\n    audioHint: string;\\n  };\\n  mundari: {\\n    devanagari: string;\\n    mundaribani?: string;\\n    roman: string;\\n    audioHint: string;\\n  };\\n}\\n\\nexport const SCHOOL_GLOSSARY: GlossaryTerm[] = [\\n  // Shapes & Spatial Terms (Class 1 Maths Ch 1)\\n  {\\n    id: \'inside\',\\n    category: \'shapes\',\\n    hindi: \'\340\244\205\340\244\202\340\244\246\340\244\260\',\\n    english: \'Inside\',\\n    santali: {\\n      olchiki: \'\341\261\265\341\261\267\341\261\244\341\261\233\341\261\250\341\261\244\',\\n      roman: \'Bhitri\',\\n      audioHint: \'Bhitri\',\\n    },\\n    ho: {\\n      warangchiti: \'\360\221\242\271\360\221\243\227\360\221\243\225\360\221\243\234\360\221\243\202\',\\n      devanagari: \'\340\244\255\340\244\277\340\244\244\340\244\260\340\245\200\',\\n      roman: \'Bhitari\',\\n      audioHint: \'Bhitari\',\\n    },\\n    mundari: {\\n      devanagari: \'\340\244\255\340\244\277\340\244\244\340\244\277\340\244\260\',\\n      roman: \'Bhitir\',\\n      audioHint: \'Bhitir\',\\n    },\\n  },\\n  {\\n    id: \'outside\',\\n    category: \'shapes\',\\n    hindi: \'\340\244\254\340\244\276\340\244\271\340\244\260\',\\n    english: \'Outside\',\\n    santali: {\\n      olchiki: \'\341\261\265\341\261\237\341\261\246\341\261\250\341\261\256\',\\n      roman: \'Bahre\',\\n      audioHint: \'Bahre\',\\n    },\\n    ho: {\\n      warangchiti: \'\360\221\242\252\360\221\243\201\360\221\243\234\360\221\243\201\',\\n      devanagari: \'\340\244\254\340\244\276\340\244\260\340\244\276\',\\n      roman: \'Bara / Bahre\',\\n      audioHint: \'Bara\',\\n    },\\n    mundari: {\\n      devanagari: \'\340\244\254\340\244\276\340\244\271\340\244\260\340\245\207\',\\n      roman: \'Bahre\',\\n      audioHint: \'Bahre\',\\n    },\\n  },\\n  {\\n    id: \'bigger\',\\n    category: \'shapes\',\\n    hindi: \'\340\244\254\340\244\241\340\244\274\340\244\276\',\\n    english: \'Bigger\',\\n    santali: {\\n      olchiki: \'\341\261\242\341\261\237\341\261\250\341\261\237\341\261\235\',\\n      roman: \'Marang\',\\n      audioHint: \'Marang\',\\n    },\\n    ho: {\\n      warangchiti: \'\360\221\242\255\360\221\243\201\360\221\243\234\360\221\243\201\360\221\243\212\',\\n      devanagari: \'\340\244\256\340\244\260\340\244\276\340\244\202\340\244\227\',\\n      roman: \'Marang\',\\n      audioHint: \'Marang\',\\n    },\\n    mundari: {\\n      devanagari: \'\340\244\256\340\244\260\340\244\276\340\244\202\340\244\227\',\\n      roman: \'Marang\',\\n      audioHint: \'Marang\',\\n    },\\n  },\\n  {\\n    id: \'smaller\',\\n    category: \'shapes\',\\n    hindi: \'\340\244\233\340\245\213\340\244\237\340\244\276\',\\n    english: \'Smaller\',\\n    santali: {\\n      olchiki: \'\341\261\240\341\261\237\341\261\271\341\261\264\341\261\244\341\261\241\',\\n      roman: \'Katij\',\\n      audioHint: \'Katij\',\\n    },\\n    ho: {\\n      warangchiti: \'\360\221\242\271\360\221\243\203\360\221\243\221\360\221\243\202\360\221\243\212\',\\n      devanagari: \'\340\244\271\340\245\201\340\244\241\340\244\277\340\244\202\340\244\227\',\\n      roman: \'Huding\',\\n      audioHint: \'Huding\',\\n    },\\n    mundari: {\\n      devanagari: \'\340\244\271\340\245\201\340\244\241\340\244\277\340\244\202\340\244\227\',\\n      roman: \'Huding\',\\n      audioHint: \'Huding\',\\n    },\\n  },\\n  {\\n    id: \'top\',\\n    category: \'shapes\',\\n    hindi: \'\340\244\212\340\244\252\340\244\260\',\\n    english: \'Top / Above\',\\n    santali: {\\n      olchiki: \'\341\261\252\341\261\25