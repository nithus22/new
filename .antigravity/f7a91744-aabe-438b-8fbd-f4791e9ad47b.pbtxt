  planner_response {
    thinking: "**Designing \"Chotu\"**\n\nI\'m now focused on the chatbot component, \"Chotu.\" I envision a friendly cartoon character interacting with children. It will leverage context about the class, subject, and chapter to answer doubts in simple language, in the child\'s preferred language. This design should be accessible for children who may be beginners in the language of instruction.\n\n\n"
    tool_calls {
      id: "call_110569"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState, useRef, useEffect } from \'react\';\\nimport { GoogleGenAI } from \'@google/genai\';\\nimport {\\n  Send,\\n  Volume2,\\n  VolumeX,\\n  Sparkles,\\n  Bot,\\n  User,\\n  Mic,\\n  RotateCcw,\\n  ShieldCheck,\\n} from \'lucide-react\';\\nimport { LanguageId } from \'../types\';\\nimport { LANGUAGES } from \'../data/languages\';\\nimport { lookupTerm, SCHOOL_GLOSSARY } from \'../data/glossary\';\\nimport { sound } from \'../utils/audio\';\\n\\ninterface ChatMessage {\\n  id: string;\\n  sender: \'chotu\' | \'child\';\\n  text: string;\\n  transliteration?: string;\\n  audioText?: string;\\n  timestamp: string;\\n}\\n\\ninterface ChatbotModalProps {\\n  isOpen: boolean;\\n  onClose: () => void;\\n  currentLanguage: LanguageId;\\n  currentClass: number;\\n  currentSubject: string;\\n  chapterTitle?: string;\\n}\\n\\nexport const ChatbotModal: React.FC<ChatbotModalProps> = ({\\n  isOpen,\\n  onClose,\\n  currentLanguage,\\n  currentClass,\\n  currentSubject,\\n  chapterTitle = \'\340\244\206\340\244\225\340\245\203\340\244\244\340\244\277\340\244\257\340\244\276\340\244\201 \340\244\224\340\244\260 \340\244\270\340\245\215\340\244\245\340\244\276\340\244\250 (Shapes & Space)\',\\n}) => {\\n  const [messages, setMessages] = useState<ChatMessage[]>([]);\\n  const [inputText, setInputText] = useState(\'\');\\n  const [isLoading, setIsLoading] = useState(false);\\n  const [isSpeakingMessageId, setIsSpeakingMessageId] = useState<string | null>(null);\\n  const messagesEndRef = useRef<HTMLDivElement | null>(null);\\n\\n  const langConfig = LANGUAGES[currentLanguage];\\n\\n  // Initialize friendly greeting\\n  useEffect(() => {\\n    if (messages.length === 0) {\\n      const initialGreeting: ChatMessage = {\\n        id: \'msg-init\',\\n        sender: \'chotu\',\\n        text:\\n          currentLanguage === \'santali\'\\n            ? \'\341\261\241\341\261\232\341\261\246\341\261\237\341\261\250! \341\261\244\341\261\247 \341\261\252\341\261\267\341\261\263\341\261\264\341\261\251 \341\261\240\341\261\237\341\261\271\341\261\261\341\261\237\341\261\271\341\261\247! \341\261\252\341\261\256\341\261\253 \341\261\240\341\261\251\341\261\240\341\261\236\341\261\244 \341\261\242\341\261\256\341\261\261\341\261\237\341\261\234 \341\261\233\341\261\237\341\261\242\341\261\237?\'\\n            : currentLanguage === \'ho\'\\n            ? \'\360\221\242\271\360\221\243\211\360\221\243\200 \360\221\243\216\360\221\243\213\360\221\243\234: \341\261\241\341\261\232\341\261\246\341\261\237\341\261\250! \341\261\237\341\261\255\341\261\244\341\261\235 \341\261\252\341\261\267\341\261\263\341\261\264\341\261\251 \341\261\233\341\261\237\341\261\261\341\261\244\341\261\235! (Johar! Ask me about this chapter!)\'\\n            : \'\340\244\234\340\245\213\340\244\271\340\244\276\340\244\260! \340\244\220\340\244\202\340\244\227 \340\244\233\340\245\213\340\244\237\340\245\202 \340\244\244\340\245\210\340\244\250\340\244\277\340\244\202\340\244\227\340\245\244 \340\244\250\340\245\207\340\244\257\340\244\276 \340\244\252\340\244\276\340\244\240 \340\244\260\340\245\207\340\244\257\340\244\276\340\244\203 \340\244\232\340\245\200\340\244\250\340\244\276 \340\244\225\340\245\201\340\244\262\340\245\200 \340\244\270\340\244\250\340\244\276\340\244\256?\',\\n        transliteration:\\n          currentLanguage === \'santali\'\\n            ? \'Johar! Ing Chhotu kanang! What question do you have?\'\\n            : currentLanguage === \'ho\'\\n            ? \'Johar! Aing Chotu taning! (I am Chotu. Ask me anything!)\'\\n            : \'Johar! Aing Chotu tanning. Ask any doubt about this lesson!\',\\n        audioText:\\n          currentLanguage === \'santali\'\\n            ? \'Johar! Ing Chhotu kanang. Chet kukli menah tama?\'\\n            : currentLanguage === \'ho\'\\n            ? \'Johar! Aing Chotu taning. Ask me any question.\'\\n            : \'Johar! Aing Chotu tanning. Ask me any question.\',\\n        timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\\n      };\\n      setMessages([initialGreeting]);\\n    }\\n  }, [currentLanguage]);\\n\\n  useEffect(() => {\\n    messagesEndRef.current?.scrollIntoView({ behavior: \'smooth\' });\\n  }, [messages]);\\n\\n  if (!isOpen) return null;\\n\\n  const handleSpeakReply = (msg: ChatMessage) => {\\n    sound.playPop();\\n    setIsSpeakingMessageId(msg.id);\\n    sound.speakText(msg.audioText || msg.transliteration || msg.text, {\\n      lang: \'hi-IN\',\\n      rate: 0.85,\\n      pitch: 1.2,\\n      onEnd: () => setIsSpeakingMessageId(null),\\n    });\\n  };\\n\\n  // Rule-based and Glossary-backed local fallback answer generator\\n  const getOfflineChotuReply = (query: string): ChatMessage => {\\n    const qLower = query.toLowerCase();\\n\\n    // Check shapes & vocabulary words\\n    if (qLower.includes(\'inside\') || qLower.includes(\'\340\244\205\340\244\202\340\244\246\340\244\260\') || qLower.includes(\'bhitri\') || qLower.includes(\'bhitir\')) {\\n      if (currentLanguage === \'santali\') {\\n        return {\\n          id: String(Date.now()),\\n          sender: \'chotu\',\\n          text: \'\341\261\265\341\261\267\341\261\244\341\261\233\341\261\250\341\261\244 (Bhitri) \341\261\242\341\261\256\341\261\261\341\261\236\341\261\256\341\261\240\341\261\267\341\261\237\341\261\261 Inside \341\261\265\341\261\237\341\261\235\341\261\242\341\261\237 \341\261\233\341\261\237\341\261\271\341\261\242\341\261\265\341\261\251 \341\261\265\341\261\267\341\261\244\341\261\233\341\261\250\341\261\244 \341\261\250\341\261\256 \341\261\233\341\261\237\341\261\246\341\261\256\341\261\270\341\261\261!\',\\n          transliteration: \'Bhitri means Inside, like Arab sitting inside the tent!\',\\n          audioText: \'Bhitri means inside. Arab do tambu bhitri re tahena.\',\\n          timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\\n        };\\n      } else if (currentLanguage === \'ho\') {\\n        return {\\n          id: String(Date.now()),\\n          sender: \'chotu\',\\n          text: \'\360\221\242\271\360\221\243\227\360\221\243\225\360\221\243\234\360\221\243\202 (Bhitari / \340\244\255\340\244\277\340\244\244\340\244\260\340\245\200) \340\244\256\340\244\276\340\244\250\340\245\207 \340\244\205\340\244\202\340\244\246\340\244\260, \340\244\234\340\245\207\340\244\262\340\245\207\340\244\225\340\244\276 \340\244\244\340\244\202\340\244\254\340\245\202 \340\244\255\340\244\277\340\244\244\340\244\260\340\245\200!\',\\n          transliteration: \'Bhitari means Inside (\340\244\205\340\244\202\340\244\246\340\244\260), like sitting inside the tent!\',\\n          audioText: \'Bhitari means inside, like Arab in the tent.\',\\n          timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\\n        };\\n      } else {\\n        return {\\n          id: String(Date.now()),\\n          sender: \'chotu\',\\n          text: \'\340\244\255\340\244\277\340\244\244\340\244\277\340\244\260 (Bhitir) \340\244\256\340\244\276\340\244\250\340\245\207 \340\244\205\340\244\202\340\244\246\340\244\260, \340\244\234\340\245\207\340\244\262\340\245\207\340\244\225\340\244\276 \340\244\244\340\244\202\340\244\254\340\245\202 \340\244\255\340\244\277\340\244\244\340\244\277\340\244\260 \340\244\260\340\245\207 \340\244\254\340\245\213\340\244\262\340\244\257\340\245\207\340\244\250\340\244\276!\',\\n          transliteration: \'Bhitir means Inside, like resting inside the tent!\',\\n          audioText: \'Bhitir means inside, like Arab inside the tent.\',\\n          timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\\n        };\\n      }\\n    }\\n\\n    if (qLower.includes(\'outside\') || qLower.includes(\'\340\244\254\340\244\276\340\244\271\340\244\260\') || qLower.includes(\'bahre\') || qLower.includes(\'bara\')) {\\n      return {\\n        id: String(Date.now()),\\n        sender: \'chotu\',\\n        text: currentLanguage === \'santali\' ? \'\341\261\265\341\261\237\341\261\246\341\261\250\341\261\256 (Bahre) \341\261\242\341\261\256\341\261\261\341\261\236\341\261\256\341\261\240\341\261\267\341\261\237\341\261\261 Outside! \341\261\251\341\261\270\341\261\264 \341\261\253\341\261\232 \341\261\265\341\261\237\341\261\246\341\261\250\341\261\256 \341\261\250\341\261\256 \341\261\233\341\261\237\341\261\246\341\261\256\341\261\270 \341\261\240\341\261\237\341\261\261\341\261\237\341\261\255\341\261\276\' : \'\340\244\254\340\244\276\340\244\271\340\244\260 / Bahre means outside! The camel was outside in the open air.\',\\n        transliteration: \'Bahre means outside the tent.\',\\n        audioText: \'Bahre means outside. Unt was outside.\',\\n        timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\\n      };\\n    }\\n\\n    if (qLower.includes(\'big\') || qLower.includes(\'\340\244\254\340\244\241\340\244\274\340\244\276\') || qLower.includes(\'marang\') || qLower.includes(\'\340\244\271\340\244\276\340\244\245\340\245\200\')) {\\n      return {\\n        id: String(Date.now()),\\n        sender: \'chotu\',\\n        text: currentLanguage === \'santali\' ? \'\341\261\242\341\261\237\341\261\250\341\261\237\341\261\235 (Marang) \341\261\242\341\261\256\341\261\261\341\261\236\341\261\256\341\261\240\341\261\267\341\261\237\341\261\261 Bigger! \341\261\246\341\261\237\341\261\271\341\261\233\341\261\244 \341\261\253\341\261\232 \341\261\242\341\261\237\341\261\250\341\261\237\341\261\235 \341\261\234\341\261\256\341\261\255\341\261\237\341\261\255!\' : \'\340\244\256\340\244\260\340\244\276\340\244\202\340\244\227 (Marang) means Bigger! The elephant (\340\244\271\340\244\276\340\244\244\340\245\200) is big.\',\\n        transliteration: \'Marang means Bigger! Elephant is big!\',\\n        audioText: \'Marang means bigger! Elephant is big.\',\\n        timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\\n      };\\n    }\\n\\n    if (qLower.includes(\'small\') || qLower.includes(\'\340\244\233\340\245\213\340\244\237\340\244\276\') || qLower.includes(\'katij\') || qLower.includes(\'huding\')) {\\n      return {\\n        id: String(Date.now()),\\n        sender: \'chotu\',\\n        text: currentLanguage === \'santali\' ? \'\341\261\240\341\261\237\341\261\271\341\261\264\341\261\244\341\261\241 (Katij) \341\261\242\341\261\256\341\261\261\341\261\236\341\261\256\341\261\240\341\261\267\341\261\237\341\261\261 Smaller! \341\261\245\341\261\256\341\261\233\341\261\237 \341\261\253\341\261\232 \341\261\240\341\261\237\341\261\271\341\261\264\341\261\244\341\261\241 \341\261\234\341\261\256\341\261\255\341\261\237\341\261\255!\' : \'\340\244\271\340\245\201\340\244\241\340\244\277\340\244\202\340\244\227 (Huding) / Katij means Smaller! The puppy is small.\',\\n        transliteration: \'Katij / Huding means Smaller!\',\\n        audioText: \'Katij means small, like the puppy.\',\\n        timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\\n      };\\n    }\\n\\n    if (qLower.includes(\'count\') || qLower.includes(\'\340\244\227\340\244\277\340\244\250\') || qLower.includes(\'number\') || qLower.includes(\'1\') || qLower.includes(\'\340\244\217\340\244\225\')) {\\n      return {\\n        id: String(Date.now()),\\n        sender: \'chotu\',\\n        text:\\n          currentLanguage === \'santali\'\\n            ? \'\341\261\245\341\261\237\341\261\261\341\261\233\341\261\237\341\261\262\341\261\244 \341\261\233\341\261\256 \341\261\236\341\261\256\341\261\240\341\261\267\341\261\237: \341\261\242\341\261\244\341\261\253 (1), \341\261\265\341\261\237\341\261\250 (2), \341\261\257\341\261\256 (3), \341\261\257\341\261\263\341\261\261 (4), \341\261\242\341\261\232\341\261\254\341\261\256 (5)!\'\\n            : currentLanguage === \'ho\'\\n            ? \'\340\244\271\340\245\213 \340\244\234\340\244\227\340\244\260 \340\244\260\340\245\207 \340\244\262\340\245\207\340\244\226\340\244\276: \360\221\242\255\360\221\243\202\360\221\243\201 (\340\245\247), \360\221\242\252\360\221\243\201\360\221\243\234\360\221\243\202\360\221\243\201 (\340\245\250), \360\221\242\240\360\221\243\202\360\221\243\201 (\340\245\251), \360\221\242\241\360\221\243\203\360\221\243\205\360\221\243\202\360\221\243\201 (\340\245\252), \360\221\242\255\360\221\243\211\360\221\243\216\360\221\243\202\360\221\243\201 (\340\245\253)!\'\\n            : \'\340\244\256\340\245\201\340\244\243\340\245\215\340\244\241\340\244\276\340\244\260\340\245\200 \340\244\260\340\245\207 \340\244\262\340\245\207\340\244\226\340\244\276: \340\244\256\340\244\277\340\244\257\340\244\276\340\244\246 (\340\245\247), \340\244\254\340\244\276\340\244\260\340\244\277\340\244\257\340\244\276 (\340\245\250), \340\244\205\340\244\252\340\244\277\340\244\257\340\244\276 (\340\245\251), \340\244\211\340\244\252\340\245\201\340\244\250\340\244\277\340\244\257\340\244\276 (\340\245\252), \340\244\256\340\245\213\340\244\241\340\244\274\340\245\207\340\244\257\340\244\276 (\340\245\253)!\',\\n        transliteration: \'Numbers 1 to 5: Mit (1), Bar (2), Pe (3), Pon (4), More (5)\',\\n        audioText: \'Counting 1 to 5: Mit, Bar, Pe, Pon, More!\',\\n        timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\\n      };\\n    }\\n\\n    // Honest fallback if word not in digital corpus for Ho/Mundari\\n    return {\\n      id: String(Date.now()),\\n      sender: \'chotu\',\\n      text: `\341\261\261\341\261\232\341\261\243\341\261\237 \341\261\240\341\261\237\341\261\233\341\261\267\341\261\237 (I want to be honest: Ho and Mundari digital resources are still learning this word). In Hindi: \340\244\257\340\244\271 ${chapterTitle} \340\244\225\340\244\276 \340\244\265\340\244\277\340\244\267\340\244\257 \340\244\271\340\245\210\340\245\244 Ask me about Inside/Outside, Big/Small, or Numbers!`,\\n      transliteration: `I am confident about textbook words for ${chapterTitle}! Ask me about Bhitri, Bahre, Marang, or Katij.`,\\n      audioText: `I am your friend Chotu. You can ask me about inside, outside, big and small!`,\\n      timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\\n    };\\n  };\\n\\n  const handleSendMessage = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    if (!inputText.trim()) return;\\n\\n    sound.playPop();\\n    const childMsg: ChatMessage = {\\n      id: String(Date.now()),\\n      sender: \'child\',\\n      text: inputText.trim(),\\n      timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\\n    };\\n\\n    setMessages((prev) => [...prev, childMsg]);\\n    const query = inputText.trim();\\n    setInputText(\'\');\\n    setIsLoading(true);\\n\\n    try {\\n      // Check if GEMINI_API_KEY is available in browser / env\\n      const apiKey = (window as unknown as { GEMINI_API_KEY?: string }).GEMINI_API_KEY || \'\';\\n\\n      if (apiKey) {\\n        const ai = new GoogleGenAI({ apiKey });\\n        const prompt = `You are \\\"Chotu\\\", a cute friendly deer mascot helping primary school children (Classes 1-5) in Jharkhand, India.\\nThe child is currently studying:\\n- Class: ${currentClass}\\n- Subject: ${currentSubject}\\n- Chapter: ${chapterTitle}\\n- Mother Tongue: ${langConfig.name} (${langConfig.scriptName})\\n\\nRules:\\n1. Answer in very simple, kind, cheerful 1-2 sentences suitable for a 6-year-old child.\\n2. If possible, include the mother tongue word in native script: Santali (Ol Chiki), Ho (Warang Chiti / Devanagari), or Mundari (Devanagari).\\n3. If unsure of exact dialect words in Ho or Mundari, say so honestly and provide the Hindi or English translation. Never invent false words.\\n4. Refuse any unsafe or off-topic questions gently by guiding back to school lessons.\\n5. Provide a Roman transliteration or phonetic guide.\\n\\nChild\'s message: \\\"${query}\\\"`;\\n\\n        const response = await ai.models.generateContent({\\n          model: \'gemini-2.5-flash\',\\n          contents: prompt,\\n        });\\n\\n        const replyText = response.text || \'\';\\n        const botMsg: ChatMessage = {\\n          id: String(Date.now() + 1),\\n          sender: \'chotu\',\\n          text: replyText,\\n          transliteration: \'Spoken by Chotu AI\',\\n          audioText: replyText.replace(/[\\\\u1C50-\\\\u1C7F\\\\u118A0-\\\\u118FF]/g, \'\'), // strip special scripts for phonetic audio speech\\n          timestamp: new Date().toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' }),\\n        };\\n        setMessages((prev) => [...prev, botMsg]);\\n        handleSpeakReply(botMsg);\\n      } else {\\n        // Instant responsive offline glossary-backed answer\\n        setTimeout(() => {\\n          const offlineMsg = getOfflineChotuReply(query);\\n          setMessages((prev) => [...prev, offlineMsg]);\\n          handleSpeakReply(offlineMsg);\\n        }, 400);\\n      }\\n    } catch {\\n      const offlineMsg = getOfflineChotuReply(query);\\n      setMessages((prev) => [...prev, offlineMsg]);\\n      handleSpeakReply(offlineMsg);\\n    } finally {\\n      setIsLoading(false);\\n    }\\n  };\\n\\n  return (\\n    <div className=\\\"fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-center justify-center p-3 sm:p-4 animate-fade-in\\\">\\n      <div className=\\\"bg-white rounded-3xl max-w-lg w-full h-[85vh] flex flex-col border-4 border-amber-400 shadow-2xl overflow-hidden\\\">\\n        {/* Top Header */}\\n        <div className=\\\"bg-gradient-to-r from-amber-400 via-orange-400 to-amber-400 p-3 sm:p-4 border-b-2 border-amber-500 flex items-center justify-between\\\">\\n          <div className=\\\"flex items-center gap-2.5\\\">\\n            <div className=\\\"w-10 h-10 rounded-2xl bg-white flex items-center justify-center text-2xl shadow-sm border border-amber-300\\\">\\n              \360\237\246\214\\n            </div>\\n            <div>\\n              <h3 className=\\\"text-base sm:text-lg font-black text-amber-950 flex items-center gap-1.5 leading-tight\\\">\\n                <span>Ask Chotu (\341\261\252\341\261\267\341\261\263\341\261\264\341\261\251)</span>\\n                <span className=\\\"text-[10px] bg-emerald-700 text-white font-bold px-1.5 py-0.5 rounded-full\\\">\\n                  Child Safe\\n                </span>\\n              </h3>\\n              <p className=\\\"text-xs text-amber-900 font-bold\\\">\\n                Class {currentClass} \342\200\242 {chapterTitle} \342\200\242 {langConfig.name}\\n              </p>\\n            </div>\\n          </div>\\n\\n          <button\\n            onClick={() => {\\n              sound.playPop();\\n              sound.stopSpeech();\\n              onClose();\\n            }}\\n            className=\\\"w-8 h-8 rounded-full bg-white/80 hover:bg-white text-amber-950 font-black text-sm flex items-center justify-center shadow-xs\\\"\\n            aria-label=\\\"Close Chat\\\"\\n          >\\n            \342\234\225\\n          </button>\\n        </div>\\n\\n        {/* Chat Messages Log */}\\n        <div className=\\\"flex-1 overflow-y-auto p-4 space-y-3 bg-amber-50/50\\\">\\n          {messages.map((msg) => {\\n            const isChotu = msg.sender === \'chotu\';\\n            const isSpeaking = isSpeakingMessageId === msg.id;\\n\\n            return (\\n              <div\\n                key={msg.id}\\n                className={`flex gap-2 items-start ${isChotu ? \'justify-start\' : \'justify-end\'}`}\\n              >\\n                {isChotu && (\\n                  <div className=\\\"w-8 h-8 rounded-full bg-amber-300 border border-amber-500 flex items-center justify-center text-sm shrink-0\\\">\\n                    \360\237\246\214\\n                  </div>\\n                )}\\n\\n                <div\\n                  className={`max-w-[85%] rounded-3xl p-3.5 shadow-sm text-sm space-y-1 ${\\n                    isChotu\\n                      ? \'bg-white border-2 border-amber-300 text-amber-950 rounded-tl-none\'\\n                      : \'bg-amber-500 text-white font-bold rounded-tr-none\'\\n                  }`}\\n                >\\n                  <p className=\\\"font-bold leading-relaxed whitespace-pre-wrap\\\">\\n                    {msg.text}\\n                  </p>\\n\\n                  {msg.transliteration && (\\n                    <p className={`text-xs mt-1 ${isChotu ? \'text-amber-800\' : \'text-amber-100\'}`}>\\n                      {msg.transliteration}\\n                    </p>\\n                  )}\\n\\n                  <div className=\\\"flex items-center justify-between pt-1\\\">\\n                    <span className={`text-[10px] ${isChotu ? \'text-slate-400\' : \'text-amber-200\'}`}>\\n                      {msg.timestamp}\\n                    </span>\\n\\n                    {isChotu && (\\n                      <button\\n                        onClick={() => handleSpeakReply(msg)}\\n                        className={`p-1 rounded-full ${\\n                          isSpeaking ? \'bg-amber-400 text-white animate-pulse\' : \'hover:bg-amber-100 text-amber-800\'\\n                        }`}\\n                        title=\\\"Read aloud\\\"\\n                      >\\n                        <Volume2 className=\\\"w-3.5 h-3.5\\\" />\\n                      </button>\\n                    )}\\n                  </div>\\n                </div>\\n\\n                {!isChotu && (\\n                  <div className=\\\"w-8 h-8 rounded-full bg-amber-600 text-white flex items-center justify-center text-xs font-black shrink-0\\\">\\n                    \360\237\221\266\\n                  </div>\\n                )}\\n              </div>\\n            );\\n          })}\\n\\n          {isLoading && (\\n            <div className=\\\"flex items-center gap-2 text-xs font-bold text-amber-800 bg-white p-3 rounded-2xl border border-amber-200 w-fit animate-pulse\\\">\\n              <span>\360\237\246\214 Chotu is thinking...</span>\\n            </div>\\n          )}\\n\\n          <div ref={messagesEndRef} />\\n        </div>\\n\\n        {/* Quick Question Pills for Young Children */}\\n        <div className=\\\"p-2 bg-amber-100/90 border-t border-amber-200 flex items-center gap-1.5 overflow-x-auto text-xs whitespace-nowrap\\\">\\n          <span className=\\\"font-black text-amber-900 text-[11px] px-1\\\">Try:</span>\\n          <button\\n            onClick={() => {\\n              setInputText(\'\340\244\205\340\244\202\340\244\246\340\244\260 \340\244\225\340\245\213 \340\244\270\340\244\202\340\244\244\340\244\276\340\244\262\340\245\200 \340\244\256\340\245\207\340\244\202 \340\244\225\340\245\215\340\244\257\340\244\276 \340\244\225\340\244\271\340\244\244\340\245\207 \340\244\271\340\245\210\340\244\202?\');\\n            }}\\n            className=\\\"px-2.5 py-1 rounded-xl bg-white hover:bg-amber-200 text-amber-950 font-bold border border-amber-300\\\"\\n          >\\n            What is Inside in Santali?\\n          </button>\\n          <button\\n            onClick={() => {\\n              setInputText(\'\340\244\254\340\244\241\340\244\274\340\244\276 \340\244\224\340\244\260 \340\244\233\340\245\213\340\244\237\340\244\276 \340\244\225\340\245\213 \340\244\271\340\245\213 \340\244\234\340\244\227\340\244\260 \340\244\256\340\245\207\340\244\202 \340\244\225\340\245\215\340\244\257\340\244\276 \340\244\225\340\244\271\340\244\244\340\245\207 \340\244\271\340\245\210\340\244\202?\');\\n            }}\\n            className=\\\"px-2.5 py-1 rounded-xl bg-white hover:bg-amber-200 text-amber-950 font-bold border border-amber-300\\\"\\n          >\\n            Big & Small in Ho?\\n          </button>\\n          <button\\n            onClick={() => {\\n              setInputText(\'\340\244\227\340\244\277\340\244\250\340\244\244\340\245\200 \340\244\225\340\245\210\340\244\270\340\245\207 \340\244\254\340\245\213\340\244\262\340\244\244\340\245\207 \340\244\271\340\245\210\340\244\202?\');\\n            }}\\n            className=\\\"px-2.5 py-1 rounded-xl bg-white hover:bg-amber-200 text-amber-950 font-bold border border-amber-300\\\"\\n          >\\n            How to count in Mundari?\\n          </button>\\n        </div>\\n\\n        {/* Input Bar */}\\n        <form\\n          onSubmit={handleSendMessage}\\n          className=\\\"p-3 bg-white border-t-2 border-amber-300 flex items-center gap-2\\\"\\n        >\\n          <input\\n            type=\\\"text\\\"\\n            value={inputText}\\n            onChange={(e) => setInputText(e.target.value)}\\n            placeholder={`Ask Chotu in ${langConfig.name}, Hindi or English...`}\\n            className=\\\"flex-1 px-4 py-2.5 rounded-2xl border-2 border-amber-300 focus:border-amber-500 focus:outline-none text-sm font-bold text-amber-950 placeholder:text-slate-400\\\"\\n          />\\n\\n          <button\\n            type=\\\"submit\\\"\\n            disabled={!inputText.trim() || isLoading}\\n            className=\\\"p-2.5 rounded-2xl bg-amber-500 hover:bg-amber-600 disabled:opacity-50 text-white font-bold shadow-md press-bounce transition-all border border-amber-700\\\"\\n            aria-label=\\\"Send message\\\"\\n          >\\n            <Send className=\\\"w-4 h-4\\\" />\\n          </button>\\n        </form>\\n      </div>\\n    </div>\\n  );\\n};\\n\",\"Description\":\"Create child-safe multilingual Chatbot modal with Gemini API integration and instant offline fallback\",\"Overwrite\":true,\"TargetFile\":\"/src/components/ChatbotModal.tsx\",\"toolAction\":\"Creating ChatbotModal.tsx\",\"toolSummary\":\"Create ChatbotModal component\"}"
