  code_action {
    action_spec {
      create_file {
        instruction: "@import \"tailwindcss\";\n\n@layer base {\n  :root {\n    --font-cartoon: \'Baloo 2\', \'Fredoka\', cursive, sans-serif;\n    --font-olchiki: \'Noto Sans Ol Chiki\', \'Baloo 2\', sans-serif;\n    --font-warangchiti: \'Noto Sans Warang Chiti\', \'Baloo 2\', sans-serif;\n    --font-devanagari: \'Baloo 2\', \'Noto Sans Devanagari\', sans-serif;\n  }\n\n  body {\n    font-family: var(--font-cartoon);\n    user-select: none;\n    -webkit-tap-highlight-color: transparent;\n  }\n}\n\n/* Custom script fonts */\n.font-olchiki {\n  font-family: \'Noto Sans Ol Chiki\', \'Baloo 2\', sans-serif;\n}\n\n.font-warangchiti {\n  font-family: \'Noto Sans Warang Chiti\', \'Baloo 2\', sans-serif;\n}\n\n.font-devanagari {\n  font-family: \'Baloo 2\', \'Noto Sans Devanagari\', sans-serif;\n}\n\n.font-cartoon {\n  font-family: \'Baloo 2\', \'Fredoka\', cursive, sans-serif;\n}\n\n/* Children\'s Cartoon Floating & Bouncing Animations */\n@keyframes gentle-bounce {\n  0%, 100% {\n    transform: translateY(0);\n  }\n  50% {\n    transform: translateY(-8px);\n  }\n}\n\n@keyframes float-cloud {\n  0% {\n    transform: translateX(-10%);\n  }\n  50% {\n    transform: translateX(10%);\n  }\n  100% {\n    transform: translateX(-10%);\n  }\n}\n\n@keyframes wiggle {\n  0%, 100% { transform: rotate(0deg); }\n  25% { transform: rotate(-3deg); }\n  75% { transform: rotate(3deg); }\n}\n\n@keyframes pulse-soft {\n  0%, 100% { transform: scale(1); }\n  50% { transform: scale(1.04); }\n}\n\n.animate-gentle-bounce {\n  animation: gentle-bounce 2.6s ease-in-out infinite;\n}\n\n.animate-wiggle {\n  animation: wiggle 1.2s ease-in-out infinite;\n}\n\n.animate-pulse-soft {\n  animation: pulse-soft 2s ease-in-out infinite;\n}\n\n.animate-float-slow {\n  animation: float-cloud 20s ease-in-out infinite;\n}\n\n/* Touch friendly button active press feedback */\n.press-bounce {\n  transition: transform 0.1s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.1s ease;\n}\n.press-bounce:active {\n  transform: translateY(4px) scale(0.97);\n}\n\n/* High contrast mode */\n.high-contrast {\n  filter: contrast(135%);\n}\n\n.high-contrast * {\n  border-width: max(2px, border-width) !important;\n}\n\n/* Accessibility: reduce motion support */\n@media (prefers-reduced-motion: reduce) {\n  *, ::before, ::after {\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.01ms !important;\n    scroll-behavior: auto !important;\n  }\n}\n\n/* Custom scrollbars */\n::-webkit-scrollbar {\n  width: 8px;\n  height: 8px;\n}\n::-webkit-scrollbar-track {\n  background: #fef3c7;\n  border-radius: 9999px;\n}\n::-webkit-scrollbar-thumb {\n  background: #f59e0b;\n  border-radius: 9999px;\n}\n::-webkit-scrollbar-thumb:hover {\n  background: #d97706;\n}\n"
        path {
          absolute_uri: "file:///src/index.css"
        }
        overwrite: true
      }
    }
