    summary: "\"\340\244\235\340\244\277\340\244\262\340\244\256\340\244\277\340\244\262-1\" \340\244\217\340\244\225 \340\244\271\340\244\277\340\244\202\340\244\246\340\245\200 \340\244\252\340\244\276\340\244\240\340\245\215\340\244\257\340\244\252\340\245\201\340\244\270\340\245\215\340\244\244\340\244\225 \340\244\271\340\245\210 \340\244\234\340\245\213 \340\244\265\340\244\277\340\244\255\340\244\277\340\244\250\340\245\215\340\244\250 \340\244\255\340\244\276\340\244\260\340\244\244\340\245\200\340\244\257 \340\244\266\340\244\277\340\244\225\340\245\215\340\244\267\340\244\276 \340\244\254\340\245\213\340\244\260\340\245\215\340\244\241\340\245\213\340\244\202 \340\244\256\340\245\207\340\244\202 \340\244\252\340\244\242\340\244\274\340\244\276\340\244\210 \340\244\234\340\244\276\340\244\244\340\245\200 \340\244\271\340\245\210, \340\244\234\340\244\277\340\244\270\340\244\256\340\245\207\340\244\202 \340\244\271\340\244\260\340\244\277\340\244\257\340\244\276\340\244\243\340\244\276 \340\244\254\340\245\213\340\244\260\340\245\215\340\244\241 (HBSE) \340\244\224\340\244\260 \340\244\235\340\244\276\340\244\260\340\244\226\340\244\202\340\244\241 \340\244\217\340\244\225\340\245\207\340\244\241\340\244\256\340\244\277\340\244\225 \340\244\225\340\244\276\340\244\211\340\244\202\340\244\270\340\244\277\340\244\262 (JAC) \340\244\266\340\244\276\340\244\256\340\244\277\340\244\262 \340\244\271\340\245\210\340\244\202. \340\244\235\340\244\276\340\244\260\340\244\226\340\244\202\340\244\241 \340\244\256\340\245\207\340\244\202, \"\340\244\235\340\244\277\340\244\262\340\244\256\340\244\277\340\244\262 - I\" \340\244\252\340\244\276\340\244\240\340\245\215\340\244\257\340\244\252\340\245\201\340\244\270\340\245\215\340\244\244\340\244\225\340\245\207\340\244\202 JCERT (\340\244\235\340\244\276\340\244\260\340\244\226\340\244\202\340\244\241 \340\244\266\340\245\210\340\244\225\340\245\215\340\244\267\340\244\277\340\244\225 \340\244\205\340\244\250\340\245\201\340\244\270\340\244\202\340\244\247\340\244\276\340\244\250 \340\244\224\340\244\260 \340\244\252\340\245\215\340\244\260\340\244\266\340\244\277\340\244\225\340\245\215\340\244\267\340\244\243 \340\244\252\340\244\260\340\244\277\340\244\267\340\244\246) \340\244\246\340\245\215\340\244\265\340\244\276\340\244\260\340\244\276 \340\244\250\340\244\277\340\244\260\340\245\215\340\244\247\340\244\276\340\244\260\340\244\277\340\244\244 \340\244\225\340\245\200 \340\244\234\340\244\276\340\244\244\340\245\200 \340\244\271\340\245\210\340\244\202.[1][2][3]\n\n\"\340\244\235\340\244\277\340\244\262\340\244\256\340\244\277\340\244\262-1\" \340\244\225\340\245\207 \340\244\225\340\245\201\340\244\233 \340\244\205\340\244\247\340\245\215\340\244\257\340\244\276\340\244\257 \340\244\257\340\244\276 \340\244\252\340\244\276\340\244\240\340\245\213\340\244\202 \340\244\256\340\245\207\340\244\202 \340\244\266\340\244\276\340\244\256\340\244\277\340\244\262 \340\244\271\340\245\210\340\244\202:\n*   \"\340\244\256\340\245\207\340\244\260\340\244\276 \340\244\252\340\244\260\340\244\277\340\244\232\340\244\257\" (\340\244\271\340\244\260\340\244\277\340\244\257\340\244\276\340\244\243\340\244\276 \340\244\254\340\245\213\340\244\260\340\245\215\340\244\241 \340\244\225\340\244\225\340\245\215\340\244\267\340\244\276 1 \340\244\235\340\244\277\340\244\262\340\244\256\340\244\277\340\244\262 \340\244\225\340\244\276 \340\244\205\340\244\247\340\245\215\340\244\257\340\244\276\340\244\257 1)[2]\n*   \"\340\244\230\340\245\213 -\340\244\230\340\245\213 \340\244\260\340\244\276\340\244\250\340\245\200\" (\340\244\225\340\244\225\340\245\215\340\244\267\340\244\276 -01 \340\244\271\340\244\277\340\244\202\340\244\246\340\245\200 || \340\244\235\340\244\277\340\244\262\340\244\256\340\244\277\340\244\262 | jcert hind1 \340\244\225\340\244\276 \340\244\252\340\244\276\340\244\240 2)[4][5]\n*   \"\340\244\244\340\245\200\340\244\250 \340\244\270\340\244\276\340\244\245\340\245\200\" (\3