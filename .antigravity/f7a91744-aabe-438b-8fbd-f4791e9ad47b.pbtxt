    content: "              return (\n                <span\n                  key={idx}\n                  className={`inline-block mx-1 px-1.5 py-0.5 rounded-lg transition-all ${\n                    isHighlighted\n                      ? \'bg-amber-400 text-amber-950 font-black scale-110 shadow-sm\'\n                      : \'hover:bg-amber-200 cursor-pointer\'\n                  }`}\n                  onClick={() => {\n                    sound.playPop();\n                    sound.speakText(word, { lang: \'hi-IN\', pitch: 1.2 });\n                  }}\n                  title=\"Tap to hear word\"\n                >\n                  {word}\n                </span>\n              );\n            })}\n          </div>\n\n          {/* Transliteration (Roman & Devanagari for Ho) */}\n          <div className=\"space-y-0.5 pt-2 border-t border-amber-200\">\n            <p className=\"text-sm sm:text-base font-bold text-amber-900\">\n              {currentSlide.transliteration}\n            </p>\n            {currentSlide.alternateTransliteration && (\n              <p className=\"text-xs sm:text-sm font-semibold text-slate-700\">\n                Devanagari: {currentSlide.alternateTransliteration}\n              </p>\n            )}\n          </div>\n        </div>\n\n        {/* Bridge Language Toggle (Hindi / English original explanation) */}\n        <div className=\"bg-emerald-50 rounded-2xl p-3 border border-emerald-200 space-y-1\">\n          <div className=\"flex items-center justify-between text-xs font-bold text-emerald-900\">\n            <span className=\"flex items-center gap-1\">\n              <BookOpen className=\"w-3.5 h-3.5\" />\n              <span>Bridge Language (Official JCERT Reference)</span>\n            </span>\n            <span className=\"text-[11px] uppercase tracking-wider font-extrabold text-emerald-700\">\n              {bridgeMode === \'mother-tongue\' ? \'Mother Tongue Mode\' : bridgeMode}\n            </span>\n          </div>\n\n          <div className=\"text-sm font-bold text-emerald-950\">\n            <p>\360\237\207\256\360\237\207\263 Hindi: {currentSlide.hindi}</p>\n            <p className=\"text-xs text-slate-600 mt-0.5\">\360\237\207\254\360\237\207\247 English: {currentSlide.english}</p>\n          </div>\n        </div>\n\n        {/* Visual Scene Hint */}\n        <p className=\"text-xs text-slate-500 italic\">\n          \360\237\222\241 Visual Hint: {currentSlide.visualHint}\n        </p>\n\n        {/* Slide Navigation Footers */}\n        <div className=\"flex items-center justify-between pt-3 border-t border-amber-200\">\n          <button\n            disabled={currentSlideIndex === 0}\n            onClick={handlePrevSlide}\n            className={`px-4 py-2 rounded-2xl font-bold text-xs sm:text-sm flex items-center gap-1.5 transition-all press-bounce border ${\n              currentSlideIndex === 0\n                ? \'opacity-40 cursor-not-allowed bg-stone-100 text-stone-400 border-stone-200\'\n                : \'bg-amber-200 hover:bg-amber-300 text-amber-950 border-amber-400\'\n            }`}\n          >\n            <ChevronLeft className=\"w-4 h-4\" />\n            <span>Previous</span>\n          </button>\n\n          <button\n            onClick={handleNextSlide}\n            className=\"px-5 py-2.5 rounded-2xl bg-amber-500 hover:bg-amber-600 text-white font-black text-xs sm:text-sm flex items-center gap-1.5 shadow-md press-bounce border-2 border-amber-700\"\n          >\n            <span>{currentSlideIndex + 1 < slides.length ? \'Next Concept\' : \'Finish Chapter\'}</span>\n            <ChevronRight className=\"w-4 h-4\" />\n          </button>\n        </div>\n      </div>\n\n      {/* Short Animated Video Story Modal */}\n      {showVideoModal && (\n        <div className=\"fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-center justify-center p-4 animate-fade-in\">\n          <div className=\"bg-white rounded-3xl max-w-xl w-full p-6 border-4 border-amber-400 shadow-2xl space-y-4\">\n            <div className=\"flex items-center justify-between\">\n              <div className=\"flex items-center gap-2\">\n                <span className=\"text-2xl\">\360\237\216\254</span>\n                <h3 className=\"text-lg font-black text-amber-950\">\n                  Animated Chapter Storybook\n                </h3>\n              </div>\n              <button\n                onClick={() => setShowVideoModal(false)}\n                className=\"w-8 h-8 rounded-full bg-stone-100 hover:bg-stone-200 text-stone-800 font-bold flex items-center justify-center\"\n              >\n                \342\234\225\n              </button>\n            </div>\n\n            {/* Video / Animated Storybook Simulation Player */}\n            <div className=\"relative aspect-video rounded-2xl bg-gradient-to-br from-amber-900 to-stone-900 flex flex-col items-center justify-center p-6 text-center text-white overflow-hidden border-2 border-amber-600\">\n              <div className=\"text-6xl animate-bounce mb-2\">\342\233\272 \360\237\220\252</div>\n              <p className=\"text-lg font-black text-amber-200\">\n                {langData.title}\n              </p>\n              <p className=\"text-xs text-amber-100/90 max-w-md mt-1\">\n                \"The Arab and his Camel\" illustrated tale in {currentLanguage.toUpperCase()} mother-tongue narration with Ol Chiki / Warang Chiti captions.\n              </p>\n\n              <button\n                onClick={() => {\n                  sound.playCorrect();\n                  sound.speakText(langData.audioNarrationText || currentSlide.audioPhonetic, {\n                    lang: \'hi-IN\',\n                    rate: 0.85,\n                  });\n                }}\n                className=\"mt-4 px-4 py-2 rounded-2xl bg-amber-500 hover:bg-amber-600 text-white font-black text-xs shadow-lg press-bounce flex items-center gap-2\"\n              >\n                <Play className=\"w-4 h-4 fill-current\" />\n                <span>Play Full Chapter Story Audio</span>\n              </button>\n            </div>\n\n            <p className=\"text-[11px] text-slate-500 text-center font-semibold\">\n              Supports offline cached native speaker MP4 animations and community-recorded audio clips.\n            </p>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
