    summary: "\340\244\234\340\245\207\340\244\270\340\245\200\340\244\210\340\244\206\340\244\260\340\244\237\340\245\200 (JCERT) \340\244\225\340\245\200 \"\340\244\260\340\245\213\340\244\232\340\244\225 \340\244\227\340\244\243\340\244\277\340\244\244\" \340\244\257\340\244\276 \"\340\244\227\340\244\243\340\244\277\340\244\244\" \340\244\225\340\245\200 \340\244\225\340\244\225\340\245\215\340\244\267\340\244\276 1, 2, 3, 4 \340\244\224\340\244\260 5 \340\244\225\340\245\200 \340\244\252\340\244\276\340\244\240\340\245\215\340\244\257\340\244\252\340\245\201\340\244\270\340\245\215\340\244\244\340\244\225\340\245\213\340\244\202 \340\244\225\340\245\200 \340\244\252\340\244\276\340\244\240 \340\244\270\340\245\202\340\244\232\340\245\200 \340\244\250\340\244\277\340\244\256\340\245\215\340\244\250\340\244\262\340\244\277\340\244\226\340\244\277\340\244\244 \340\244\271\340\245\210:\n\n**\340\244\225\340\244\225\340\245\215\340\244\267\340\244\276 1 (\340\244\227\340\244\243\340\244\277\340\244\244):**\n*   \340\244\227\340\244\243\340\244\277\340\244\244 \340\244\225\340\245\207 \340\244\226\340\245\207\340\244\262[1]\n*   \340\244\244\340\245\201\340\244\262\340\244\250\340\244\276[1]\n*   \340\244\217\340\244\225 \340\244\270\340\245\207 \340\244\250\340\245\214 \340\244\244\340\244\225 \340\244\225\340\245\200 \340\244\270\340\244\202\340\244\226\340\245\215\340\244\257\340\244\276\340\244\217\340\244\201[1]\n*   \340\244\234\340\245\213\340\244\241\340\244\274\340\244\250\340\244\276[1]\n*   \340\244\254\340\245\200\340\244\270 \340\244\244\340\244\225 \340\244\225\340\245\200 \340\244\270\340\244\202\340\244\226\340\245\215\340\244\257\340\244\276\340\244\217\340\244\201[1]\n*   \340\244\206\340\244\225\340\245\203\340\244\244\340\244\277\340\244\257\340\244\276\340\244\201 \340\244\224\340\244\260 \340\244\270\340\245\215\340\244\245\340\244\276\340\244\250[2][3]\n\n**\340\244\225\340\244\225\340\245\215\340\244\267\340\244\276 2 (\340\244\227\340\244\243\340\244\277\340\244\244 / \340\244\226\340\245\207\340\244\262-\340\244\226\340\245\207\340\244\262 \340\244\256\340\245\207\340\244\202 \340\244\227\340\244\243\340\244\277\340\244\244):**\n*   \340\244\206\340\244\225\340\245\203\340\244\244\340\244\277\340\244\257\340\244\276\340\244\201 \340\244\224\340\244\260 \340\244\270\340\245\215\340\244\245\340\244\276\340\244\250[4]\n*   \340\244\270\340\244\202\340\244\226\340\245\215\340\244\257\340\244\276\340\244\217\340\244\201 (Numbers)[5]\n*   \340\244\207\340\244\225\340\244\276\340\244\210, \340\244\246\340\244\271\340\244\276\340\244\210 \340\244\225\340\245\213 \340\244\270\340\244\256\340\244\235\340\245\207\340\244\202[6]\n\n**\340\244\225\340\244\225\340\245\215\340\244\267\340\244\276 3 (\340\244\227\340\244\243\340\244\277\340\244\244 / \340\244\260\340\245\213\340\244\232\340\244\225 \340\244\227\340\244\243\340\244\277\340\244\244):**\n*   \340\244\246\340\245\213\340\244\271\340\244\260\340\244\276\340\244\250\340\244\276[7]\n*   \340\244\270\340\244\202\340\244\226\340\245\215\340\244\257\340\244\276\340\244\217\340\244\201[8][7]\n*   \340\244\234\340\245\213\340\244\241\340\244\274\340\244\250\340\244\276-\340\244\230\340\244\237\340\244\276\340\244\250\340\244\276-1[7]\n*   \340\244\234\340\245\213\340\244\241\340\244\274 (Addition)[9][10]\n*   \340\244\230\340\244\237\340\244\276\340\244\265 (Subtraction)[11]\n*   \340\244\227\340\245\201\340\244\243\340\244\276 (Multiplication)[12]\n*   \340\244\270\340\244\256\340\244\257 (Time)[13]\n*   \340\244\255\340\244\276\340\244\227 (Division)[14]\n*   \340\244\234\340\245\215\340\244\257\340\244\276\340\244\256\340\244\277\340\244\244\340\244\277 (Geometry)[15]\n\n**\340\244\225\340\244\225\340\245\215\340\244\267\340\244\276 4 (\340\244\260\340\245\213\340\244\232\340\244\225 \340\244\227\340\244\243\340\244\277\340\244\244):**\n*   \340\244\234\340\245\215\340\244\257\340\244\276\340\244\256\340\244\277\340\244\244\340\245\200\340\244\257 \340\244\206\340\244\225\340\245\203\340\244\244\340\244\277\340\244\257\340\244\276\340\244\201 (Geometric Shapes)[16][17]\n*   \340\244\270\340\244\202\340\244\226\340\245\215\340\244\257\340\244\276\340\244\217\340\244\201 (Numbers)[16][18][19]\n*   \340\244\234\340\245\213\340\244\241\340\244\274 (Addition)[16]\n*   \340\244\230\340\244\237\340\244\276\340\244\265 (Subtraction)[16]\n*   \340\244\227\340\245\201\340\244\243\340\244\276 (Multiplication)[16][20][21]\n*   \340\244\255\340\244\276\340\244\227 (Division)[16]\n*   \340\244\255\340\244\277\340\244\250\340\245\215\340\244\250 (Fractions)[16]\n*   \340\244\270\340\244\256\340\244\257 (Time)[16][22][23]\n*   \340\244\256\340\244\276\340\244\252\340\244\250 (Measurement)[16]\n*   \340\244\256\340\245\201\340\244\246\340\245\215\340\244\260\340\244\276 (Currency)[16]\n*   \340\244\252\340\244\237\340\245\215\340\244\237\340\245\200\340\244\225\340\244\260\340\244\243, \340\244\225\340\245\215\340\244\267\340\245\207\340\244\244\340\245\215\340\244\260\340\244\253\340\244\262 \340\244\217\340\244\265\340\244\202 \340\244\252\340\244\260\340\244\277\340\244\256\340\244\276\340\244\252 (Tiling, Area & Perimeter)[16]\n*   \340\244\252\340\245\210\340\244\237\340\244\260\340\245\215\340\244\250 (Patterns)[16][24]\n*   \340\244\206\340\244\202\340\244\225\340\244\241\340\244\274\340\245\213\340\244\202 \340\244\225\340\244\276 \340\244\250\340\244\277\340\244\260\340\245\202\340\244\252\340\244\243 (Data Representation)[16][25]\n\n**\340\244\225\340\244\225\340\245\215\340\244\267\340\244\276 5 (\340\244\260\340\245\213\340\244\232\340\244\225 \340\244\227\340\244\243\340\244\277\340\244\244 / \340\244\227\340\244\243\340\244\277\340\244\244):**\n*   \340\244\234\340\245\215\340\244\257\340\244\276\340\244\256\340\244\277\340\244\244\340\244\277 (Geometry) (\340\244\254\340\244\277\340\244\250\340\245\215\340\244\246\340\245\201, \340\244\260\340\245\207\340\244\226\340\244\276, \340\244\260\340\245\207\340\244\226\340\244\276\340\244\226\340\244\202\340\244\241 \340\244\224\340\244\260 \340\244\225\340\244\277\340\244\260\340\244\243, \340\244\225\340\245\213\340\244\243 - \340\244\250\340\245\215\340\244\257\340\245\202\340\244\250 \340\244\225\340\245\213\340\244\243, \340\244\270\340\244\256\340\244\225\340\245\213\340\244\243, \340\244\205\340\244\247\340\244\277\340\244\225 \340\244\225\340\245\213\340\244\243)[26][27][28]\n*   \340\244\270\340\244\202\340\244\226\340\245\215\340\244\257\340\244\276\340\244\217\340\244\201 (Numbers) (\340\244\270\340\245\215\340\244\245\340\244\276\340\244\250\340\245\200\340\244\257 \340\244\256\340\244\276\340\244\250, \340\244\234\340\245\213\340\244\241\340\244\274, \340\244\230\340\244\237\340\244\276\340\244\265, \340\244\227\340\245\201\340\244\243\340\244\276, \340\244\255\340\244\276\340\244\227, \340\244\254\340\244\242\340\244\274\340\244\244\340\245\207/\340\244\230\340\244\237\340\244\244\340\245\207 \340\244\225\340\245\215\340\244\260\340\244\256, \340\244\252\340\245\215\340\244\260\340\244\270\340\244\276\340\244\260\340\244\277\340\244\244 \340\244\260\340\245\202\340\244\252)[29][30]\n*   \340\244\255\340\244\277\340\244\250\340\245\215\340\244\250 (Fraction)[31]\n*   \340\244\270\340\244\256\340\244\257 (Time)[32][33]\n*   \340\244\206\340\244\201\340\244\225\340\244\241\340\244\274\340\244\276 (Data)[34]\n*   \340\244\252\340\245\210\340\244\237\340\244\260\340\245\215\340\244\250 (Pattern)[35]\n\nSources:\n[1] [cg.gov.in](https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQEe_vnwK1PSKR6s4okE3Sku0D2wNSpobD_Z4P4drfbWIojIXjpYfJ287G3DKyBhZ2vmON4Jm8DTeuQeqjGOVKIlhDL4so23dplmAHzU9B3csRGHcGajdBL4CnjdpnloQ2GVyr0XyeDoF-scJ4PgzvwTX71ThF5TdAQHHrsGPP488swZ)\n[2] [selfstudys.com](https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQHtlc87KIY83Ayerlyto4NmCcUKUgc52YJYklhaTLfj9zxfwX-6KwnNcEzEomoV4nqfPAp-2DAZN2Po4qi1yiSih14i5ZvzkJuKuthsAxZcZrh1-GCDSHz9lMnZqQ4J5CAmhyxfEcH2Lk8eL7KJ_w4YW1PBNUh-UFVdRWuvSWteGgKojIz