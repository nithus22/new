        instruction: "import { Chapter } from \'../types\';\n\nexport const CLASS_4_CURRICULUM: Chapter[] = [\n  // =========================================================================\n  // CLASS 4 - MATHEMATICS: \"\340\244\260\340\245\213\340\244\232\340\244\225 \340\244\227\340\244\243\340\244\277\340\244\244 - 4 (JCERT Class 4)\"\n  // =========================================================================\n  {\n    id: \'c4-maths-ch1\',\n    chapterNumber: 1,\n    classNumber: 4,\n    subjectId: \'maths\',\n    bookName: \'\340\244\260\340\245\213\340\244\232\340\244\225 \340\244\227\340\244\243\340\244\277\340\244\244 - 4 (JCERT Class 4)\',\n    originalTitleHindi: \'\340\244\234\340\245\215\340\244\257\340\244\276\340\244\256\340\244\277\340\244\244\340\245\200\340\244\257 \340\244\206\340\244\225\340\245\203\340\244\244\340\244\277\340\244\257\340\244\276\340\244\201 \340\244\224\340\244\260 \340\244\225\340\245\213\340\244\243\',\n    originalTitleEnglish: \'Geometric Shapes and Angles\',\n    coverEmoji: \'\360\237\223\220\',\n    languages: {\n      santali: { title: \'\341\261\252\341\261\244\341\261\233\341\261\237\341\261\271\341\261\250 \341\261\237\341\261\250 \341\261\240\341\261\263\341\261\254 (Shapes and Angles)\', scriptText: \'\341\261\252\341\261\244\341\261\233\341\261\237\341\261\271\341\261\250 \341\261\237\341\261\250 \341\261\240\341\261\263\341\261\254\', transliteration: \'Chitar ar Kon\', reviewStatus: \'approved\', lessonSlides: [] },\n      ho: { title: \'\340\244\260\340\245\202\340\244\252 \340\244\223\340\244\202\340\244\246\340\245\213\340\244\203 \340\244\225\340\245\213\340\244\243 (Shapes & Angles)\', scriptText: \'\340\244\260\340\245\202\340\244\252 \340\244\223\340\244\202\340\244\246\340\245\213\340\244\203 \340\244\225\340\245\213\340\244\243\', transliteration: \'Rup ondo: Kon\', reviewStatus: \'teacher-reviewed\', lessonSlides: [] },\n      mundari: { title: \'\340\244\206\340\244\225\340\245\203\340\244\244\340\