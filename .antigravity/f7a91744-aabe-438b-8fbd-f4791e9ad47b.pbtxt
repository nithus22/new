    end_line: 99
    content: "import React, { useState, useEffect } from \'react\';\nimport {\n  Play,\n  Pause,\n  RotateCcw,\n  Volume2,\n  ChevronLeft,\n  ChevronRight,\n  Sparkles,\n  Gamepad2,\n  HelpCircle,\n  Video,\n  CheckCircle2,\n  BookCheck,\n  AlertCircle,\n  BookOpen,\n} from \'lucide-react\';\nimport { Chapter, LanguageId, ScriptMode, BridgeMode } from \'../types\';\nimport { StoryAnimation } from \'./StoryAnimation\';\nimport { sound } from \'../utils/audio\';\nimport { Mascot } from \'./Mascot\';\n\ninterface LessonViewProps {\n  chapter: Chapter;\n  currentLanguage: LanguageId;\n  activeScript: ScriptMode;\n  bridgeMode: BridgeMode;\n  onOpenGames: () => void;\n  onOpenChatbot: () => void;\n  onOpenReportModal: () => void;\n  onCompleteChapter: () => void;\n}\n\nexport const LessonView: React.FC<LessonViewProps> = ({\n  chapter,\n  currentLanguage,\n  activeScript,\n  bridgeMode,\n  onOpenGames,\n  onOpenChatbot,\n  onOpenReportModal,\n  onCompleteChapter,\n}) => {\n  const [currentSlideIndex, setCurrentSlideIndex] = useState(0);\n  const [isPlayingNarration, setIsPlayingNarration] = useState(false);\n  const [highlightedWordIndex, setHighlightedWordIndex] = useState<number | null>(null);\n  const [showVideoModal, setShowVideoModal] = useState(false);\n\n  const langData = chapter.languages[currentLanguage] || chapter.languages[\'santali\'];\n  const slides = langData?.lessonSlides || [];\n  const currentSlide = slides[currentSlideIndex];\n\n  // Stop speech if unmounting or slide changes\n  useEffect(() => {\n    return () => {\n      sound.stopSpeech();\n    };\n  }, [currentSlideIndex]);\n\n  const handlePlayNarration = () => {\n    if (isPlayingNarration) {\n      sound.stopSpeech();\n      setIsPlayingNarration(false);\n      setHighlightedWordIndex(null);\n      return;\n    }\n\n    if (!currentSlide) return;\n\n    sound.playPop();\n    setIsPlayingNarration(true);\n\n    const textToSpeak =\n      bridgeMode === \'hindi\'\n        ? currentSlide.hindi\n        : bridgeMode === \'english\'\n        ? currentSlide.english\n        : currentSlide.audioPhonetic || currentSlide.transliteration;\n\n    const words = textToSpeak.split(\' \');\n\n    sound.speakText(textToSpeak, {\n      lang: bridgeMode === \'english\' ? \'en-IN\' : \'hi-IN\',\n      rate: 0.82,\n      pitch: 1.15,\n      onWord: (charIndex) => {\n        // Approximate word index from charIndex\n        const wordIdx = textToSpeak.slice(0, charIndex).trim().split(/\\s+/).length - 1;\n        setHighlightedWordIndex(Math.max(0, wordIdx));\n      },\n      onEnd: () => {\n        setIsPlayingNarration(false);\n        setHighlightedWordIndex(null);\n      },\n    });\n  };\n\n  const handleNextSlide = () => {\n    sound.playPop();\n    sound.stopSpeech();"
    num_lines: 384
    num_bytes: 15508
    line_range_bytes: 2634
  }
}
