            }
            lines {
              text: "## 4. Short Guide for Teachers & Resource Persons"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "1. **Access Teacher Panel**: Click the **Teacher** button in the top navigation bar."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "2. **Audit & Review**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Filter by your assigned language (Santali, Ho, or Mundari)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Review AI draft translations against the official JCERT textbook."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Click **Edit Script / Notes** to refine spelling or dialectal phrasing."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Click **Approve Final** to certify the translation."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "3. **Student Feedback Queue**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - View flagged reports submitted by students or parents in rural classrooms."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Address disputed words and mark issues as resolved."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "4. **Export Approved Dataset**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Click **Export Dataset** to download a unified JSON dataset."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - This dataset can be provided directly to **AI4Bharat**, **Bhashini**, or State Education teams to train better foundational translation models for Jharkhand\'s indigenous languages."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "---"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "## 5. Child Safety & Privacy"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- No third-party advertisements or trackers."
