        instruction: "import React, { useState } from \'react\';\nimport confetti from \'canvas-confetti\';\nimport { CheckCircle2, XCircle, RotateCcw, Volume2, Sparkles } from \'lucide-react\';\nimport { sound } from \'../../utils/audio\';\n\ninterface QuizQuestion {\n  id: string;\n  question: {\n    native: string;\n    transliteration: string;\n    hindi: string;\n    english: string;\n  };\n  options: Array<{\n    id: string;\n    text: string;\n    emoji?: string;\n    isCorrect: boolean;\n  }>;\n  explanation: string;\n}\n\ninterface QuizGameProps {\n  questions: QuizQuestion[];\n  onComplete: (score: number) => void;\n}\n\nexport const QuizGame: React.FC<QuizGameProps> = ({\n  questions,\n  onComplete,\n}) => {\n  const [currentIdx, setCurrentIdx] = useState(0);\n  const [selectedOptionId, setSelectedOptionId] = useState<string | null>(null);\n  const [score, setScore] = useState(0);\n  const [isDone, setIsDone] = useState(false);\n\n  const currentQ = questions[currentIdx];\n\n  const handlePickOption = (option: { id: string; text: string; isCorrect: boolean }) => {\n    if (selectedOptionId !== null) return; // already picked for this question\n    setSelectedOptionId(option.id);\n\n    if (option.isCorrect) {\n      sound.playCorrect();\n      setScore((s) => s + 1);\n      confetti({\n        particleCount: 50,\n        spread: 60,\n        origin: { y: 0.7 },\n      });\n    } else {\n      sound.playBoing();\n    }\n\n    setTimeout(() => {\n      if (currentIdx + 1 < questions.length) {\n        setCurrentIdx((idx) => idx + 1);\n        setSelectedOptionId(null);\n      } else {\n        setIsDone(true);\n        sound.playCelebration();\n        confetti({\n          particleCount: 100,\n          spread: 80,\n          origin: { y: 0.6 },\n        });\n        onComplete(score + (option.isCorrect ? 1 : 0));\n      }\n    }, 1800);\n  };\n\n  const handleReset = () => {\n    sound.playPop();\n    setCurrentIdx(0);\n    setSelectedOptionId(null);\n    setScore(0);\n    setIsDone(false);\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {!isDone && currentQ && (\n        <div className=\"bg-white/95 rounded-3xl p-6 border-3 border-amber-300 shadow-md space-y-4\">\n          <div className=\"flex items-center justify-between text-xs font-black text-amber-900 border-b pb-2 border-amber-200\">\n            <span>Question {currentIdx + 1} of {questions.length}</span>\n            <span>\342\255\220 Score: {score}</span>\n          </div>\n\n          {/* Question Text */}\n          <div className=\"space-y-1 text-center\">\n            <h4 className=\"text-lg sm:text-xl font-black text-amber-950\">\n              {currentQ.question.native}\n            </h4>\n            <p className=\"text-xs sm:text-sm font-bold text-amber-800\">\n              {currentQ.question.transliteration} \342\200\242 {currentQ.question.hindi}\n            </p>\n          </div>\n\n          {/* Audio narration button */}\n          <div className=\"text-center\">\n            <button\n              onClick={() => {\n                sound.playPop();\n                sound.speakText(currentQ.question.transliteration, { lang: \'hi-IN\', pitch: 1.2 });\n              }}\n              className=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-100 hover:bg-amber-200 text-amber-900 text-xs font-bold border border-amber-300\"\n            >\n              <Volume2 className=\"w-3.5 h-3.5\" />\n              <span>Listen to Question</span>\n            </button>\n          </div>\n\n          {/* Option Tiles */}\n          <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2\">\n            {currentQ.options.map((opt) => {\n              const isSelected = selectedOptionId === opt.id;\n              const showResult = selectedOptionId !== null;\n\n              return (\n                <button\n                  key={opt.id}\n                  disabled={showResult}\n                  onClick={() => handlePickOption(opt)}\n                  className={`p-4 rounded-2xl border-3 flex flex-col items-center justify-center text-center shadow-md press-bounce transition-all ${\n                    showResult && opt.isCorrect\n                      ? \'bg-emerald-100 border-emerald-500 text-emerald-950 ring-4 ring-emerald-300\'\n                      : isSelected && !opt.isCorrect\n                      ? \'bg-red-100 border-red-500 text-red-950\'\n                      : \'bg-amber-50 hover:bg-amber-100 border-amber-300 text-amber-950\'\n                  }`}\n                  aria-label={`Option: ${opt.text}`}\n                >\n                  {opt.emoji && <span className=\"text-4xl mb-1\">{opt.emoji}</span>}\n                  <span className=\"text-sm font-black\">{opt.text}</span>\n\n                  {showResult && opt.isCorrect && (\n                    <CheckCircle2 className=\"w-5 h-5 text-emerald-600 mt-1\" />\n                  )}\n                  {isSelected && !opt.isCorrect && (\n                    <XCircle className=\"w-5 h-5 text-red-600 mt-1\" />\n                  )}\n                </button>\n              );\n            })}\n          </div>\n\n          {/* Explanation reveal */}\n          {selectedOptionId !== null && (\n            <div className=\"bg-amber-100 border border-amber-300 p-3 rounded-2xl text-center text-xs font-bold text-amber-950 animate-fade-in\">\n              \360\237\222\241 {currentQ.explanation}\n            </div>\n          )}\n        </div>\n      )}\n\n      {isDone && (\n        <div className=\"bg-emerald-100 border-4 border-emerald-400 rounded-3xl p-6 text-center space-y-4 animate-bounce\">\n          <div className=\"text-5xl\">\360\237\217\206 \360\237\214\237 \360\237\216\212</div>\n          <h3 className=\"text-2xl font-black text-emerald-950\">\n            \341\261\240\341\261\251\341\261\255\341\261\244\341\261\241\341\261\275 \341\261\242\341\261\251\341\261\252\341\261\237\341\261\271\341\261\253 \341\261\256\341\261\261\341\261\237! (Quiz Finished!)\n          </h3>\n          <p className=\"text-base font-black text-emerald-900\">\n            You scored {score} out of {questions.length} correct!\n          </p>\n          <div className=\"flex justify-center gap-3\">\n            <button\n              onClick={handleReset}\n              className=\"px-4 py-2 rounded-2xl bg-emerald-600 hover:bg-emerald-700 text-white font-black text-sm shadow-md press-bounce inline-flex items-center gap-1.5\"\n            >\n              <RotateCcw className=\"w-4 h-4\" />\n              <span>Retry Quiz</span>\n            </button>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/games/QuizGame.tsx"
        }
        overwrite: true
      }
    }
