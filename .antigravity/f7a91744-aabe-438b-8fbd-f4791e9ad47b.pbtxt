    summary: "\"\340\244\235\340\244\277\340\244\262\340\244\256\340\244\277\340\244\262-1\" (Jhilmil-1) \340\244\217\340\244\225 \340\244\271\340\244\277\340\244\202\340\244\246\340\245\200 \340\244\252\340\244\276\340\244\240\340\245\215\340\244\257\340\244\252\340\245\201\340\244\270\340\245\215\340\244\244\340\244\225 \340\244\271\340\245\210 \340\244\234\340\244\277\340\244\270\340\244\225\340\244\276 \340\244\211\340\244\252\340\244\257\340\245\213\340\244\227 \340\244\235\340\244\276\340\244\260\340\244\226\340\244\202\340\244\241 \340\244\266\340\245\210\340\244\225\340\245\215\340\244\267\340\244\277\340\244\225 \340\244\205\340\244\250\340\245\201\340\244\270\340\244\202\340\244\247\340\244\276\340\244\250 \340\244\224\340\244\260 \340\244\252\340\245\215\340\244\260\340\244\266\340\244\277\340\244\225\340\245\215\340\244\267\340\244\243 \340\244\252\340\244\260\340\244\277\340\244\267\340\244\246 (J-CERT) \340\244\225\340\245\207 \340\244\252\340\244\276\340\244\240\340\245\215\340\244\257\340\244\225\340\245\215\340\244\260\340\244\256 \340\244\256\340\245\207\340\244\202 \340\244\225\340\244\225\340\245\215\340\244\267\340\244\276 1 \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 \340\244\225\340\244\277\340\244\257\340\244\276 \340\244\234\340\244\276\340\244\244\340\244\276 \340\244\271\340\245\210[1][2][3].\n\n\"\340\244\235\340\244\277\340\244\262\340\244\256\340\244\277\340\244\262-1\" \340\244\225\340\245\207 \340\244\225\340\245\201\340\244\233 \340\244\205\340\244\247\340\245\215\340\244\257\340\244\276\340\244\257 \340\244\234\340\245\213 \340\244\265\340\245\207\340\244\254 \340\244\226\340\245\213\340\244\234 \340\244\252\340\244\260\340\244\277\340\244\243\340\244\276\340\244\256\340\245\213\340\244\202 \340\244\256\340\245\207\340\244\202 \340\244\211\340\244\262\340\245\215\340\244\262\340\244\277\340\244\226\340\244\277\340\244\244 \340\244\271\340\245\210\340\244\202:\n*   \"\340\244\244\340\245\200\340\244\250 \340\244\270\340\244\276\340\244\245\340\245\200\" (\340\244\252\340\244\276\340\244\240 3)[1]\n*   \"\340\244\256\340\245\207\340\244\260\340\244\276 \340\244\227\340\244\276\340\244\201\340\244\265\"[3]\n\n\340\244\257\340\244\271 \340\244\247\340\245\215\340\244\257\340\244\276\340\244\250 \340\244\260\340\244\226\340\244\250\340\244\276 \340\244\256\340\244\271\340\244\244\340\245\215\340\244\265\340\244\252\340\245\202\340\244\260\340\245\215\340\244\243 \340\244\271\340\245\210 \340\244\225\340\244\277 \"\340\244\235\340\244\277\340\244\262\340\244\256\340\244\277\340\244\262\" \340\244\252\340\244\276\340\244\240\340\245\215\340\244\257\340\244\252\340\245\201\340\244\270\340\245\215\340\244\244\340\244\225 \340\244\266\340\245\215\340\244\260\340\245\203\340\244\202\340\244\226\340\244\262\340\244\276 \340\244\235\340\244\276\340\244\260\340\244\226\340\244\202\340\244\241 \340\244\225\340\245\207 \340\244\205\340\244\262\340\244\276\340\244\265\340\244\276 \340\244\205\340\244\250\340\245\215\340\244\257 \340\244\260\340\244\276\340\244\234\340\245\215\340\244\257\340\245\213\340\244\202 \340\244\225\340\245\207 \340\244\266\340\245\210\340\244\225\340\245\215\340\244\267\340\244\277\340\244\225 \340\244\254\340\245\213\340\244\260\340\245\215\340\244\241\340\245\213\340\244\202 (\340\244\234\340\245\210\340\244\270\340\245\207 \340\244\271\340\244\260\340\244\277\340\244\257\340\244\276\340\244\243\340\244\276 \340\244\254\340\245\213\340\244\260\340\245\215\340\244\241) \340\244\224\340\244\260 \340\244\265\340\244\277\340\244\255\340\244\277\340\244\250\340\245\215\340\244\250 \340\244\225\340\244\225\340\245\215\340\244\267\340\244\276\340\244\223\340\244\202 (\340\244\234\340\245\210\340\244\270\340\245\207 \340\244\225\340\244\225\340\245\215\340\244\267\340\244\276 2, 3, 4 \340\244\224\340\244\260 5) \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 \340\244\255\340\245\200 \340\244\211\340\244\252\340\244\257\340\245\213\340\244\227 \340\244\225\340