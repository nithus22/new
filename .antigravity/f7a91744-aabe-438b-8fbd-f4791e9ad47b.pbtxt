     audioNarrationText: \'Johar! Tehen do aabu Hunur ondo Thanu jeta bicarbua. Bhitor ondo Baare!\',\\n        lessonSlides: [\\n          {\\n            id: \'s1-c1-ho\',\\n            conceptKey: \'inside_outside\',\\n            native: \'\360\221\242\252\360\221\243\202\360\221\243\225\360\221\243\211\360\221\243\234 \360\221\243\211\360\221\243\200\360\221\243\221\360\221\243\211\360\221\243\200 \360\221\242\252\360\221\243\201\360\221\243\201\360\221\243\234\360\221\243\210 (Bhitor ondo: Baare)\',\\n            transliteration: \'Bhitor ondo: Baare\',\\n            alternateTransliteration: \'\340\244\255\340\244\277\340\244\244\340\244\260 \340\244\223\340\244\202\340\244\246\340\245\213\340\244\203 \340\244\254\340\244\276\340\244\260\340\245\207\',\\n            hindi: \'\340\244\205\340\244\202\340\244\246\340\244\260 \340\244\224\340\244\260 \340\244\254\340\244\276\340\244\271\340\244\260\',\\n            english: \'Inside and Outside\',\\n            audioPhonetic: \'Bhitor ondo: Baare. Arab do tambu bhitor re, Unt do baare re!\',\\n            sceneType: \'inside_outside\',\\n            visualHint: \'The Arab rests inside the tent, the camel rests outside in Ho landscape.\',\\n            keywords: [\\n              { native: \'\360\221\242\252\360\221\243\202\360\221\243\225\360\221\243\211\360\221\243\234\', transliteration: \'Bhitor\', hindi: \'\340\244\205\340\244\202\340\244\246\340\244\260\', english: \'Inside\' },\\n              { native: \'\360\221\242\252\360\221\243\201\360\221\243\201\360\221\243\234\360\221\243\210\', transliteration: \'Baare\', hindi: \'\340\244\254\340\244\276\340\244\271\340\244\260\', english: \'Outside\' },\\n              { native: \'\360\221\242\241\360\221\243\202\360\221\243\234\360\221\243\203\', transliteration: \'Unt\', hindi: \'\340\244\212\340\244\201\340\244\237\', english: \'Camel\' },\\n            ],\\n          },\\n        ],\\n        gameData: {\\n          dragDrop: {\\n            instruction: {\