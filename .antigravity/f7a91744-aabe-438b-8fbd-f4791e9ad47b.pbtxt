  view_file {
    absolute_path_uri: "file:///src/data/curriculum.ts"
    end_line: 99
    content: "import { Chapter } from \'../types\';\n\nexport const INITIAL_CURRICULUM: Chapter[] = [\n  // =========================================================================\n  // CLASS 1 - MATHEMATICS: \"\340\244\227\340\244\243\340\244\277\340\244\244 \340\244\225\340\244\276 \340\244\234\340\244\276\340\244\246\340\245\202 (JCERT Class 1)\"\n  // =========================================================================\n  {\n    id: \'c1-maths-ch1\',\n    chapterNumber: 1,\n    classNumber: 1,\n    subjectId: \'maths\',\n    bookName: \'\340\244\227\340\244\243\340\244\277\340\244\244 \340\244\225\340\244\276 \340\244\234\340\244\276\340\244\246\340\245\202 (JCERT Class 1)\',\n    originalTitleHindi: \'\340\244\206\340\244\225\340\245\203\340\244\244\340\244\277\340\244\257\340\244\276\340\244\201 \340\244\224\340\244\260 \340\244\270\340\245\215\340\244\245\340\244\276\340\244\250\',\n    originalTitleEnglish: \'Shapes and Space\',\n    coverEmoji: \'\342\233\272\',\n    languages: {\n      santali: {\n        title: \'\341\261\252\341\261\244\341\261\233\341\261\237\341\261\271\341\261\250 \341\261\237\341\261\250 \341\261\264\341\261\267\341\261\237\341\261\266 (Chitar ar Thanw)\',\n        scriptText: \'\341\261\252\341\261\244\341\261\233\341\261\237\341\261\271\341\261\250 \341\261\237\341\261\250 \341\261\264\341\261\267\341\261\237\341\261\266\',\n        transliteration: \'Chitar ar Thanw\',\n        reviewStatus: \'approved\',\n        lastReviewedBy: \'Hemant Soren (Santali Language Resource Group, Dumka)\',\n        reviewNotes: \'Verified with JCERT Ol Chiki syllabus standard 2024.\',\n        audioNarrationText: \'Johar gidra ko! Teheng do aban Chitar ar Thanw baabotte bon parhao-a. Bhitri ar Bahre, Marang ar Katij!\',\n        lessonSlides: [\n          {\n            id: \'s1-c1-san\',\n            conceptKey: \'inside_outside\',\n            native: \'\341\261\265\341\261\267\341\261\244\341\261\233\341\261\250\341\261\244 \341\261\237\341\261\250 \341\261\265\341\261\237\341\261\246\341\261\250\341\261\256 (Bhitri ar Bahre)\',\n            transliteration: \'Bhitri ar Bahre\',\n            hindi: \'\340\244\205\340\244\202\340\244\246\340\244\260 \340\244\224\340\244\260 \340\244\254\340\244\276\340\244\271\340\244\260\',\n            english: \'Inside and Outside\',\n            audioPhonetic: \'Bhitri ar Bahre. Arab do tambu bhitri re, Unt do bahre re!\',\n            sceneType: \'inside_outside\',\n            visualHint: \'The Arab sits inside the warm tent, while the friendly camel rests outside in the desert cool breeze.\',\n            keywords: [\n              { native: \'\341\261\265\341\261\267\341\261\244\341\261\233\341\261\250\341\261\244\', transliteration: \'Bhitri\', hindi: \'\340\244\205\340\244\202\340\244\246\340\244\260\', english: \'Inside\' },\n              { native: \'\341\261\265\341\261\237\341\261\246\341\261\250\341\261\256\', transliteration: \'Bahre\', hindi: \'\340\244\254\340\244\276\340\244\271\340\244\260\', english: \'Outside\' },\n              { native: \'\341\261\233\341\261\237\341\261\271\341\261\242\341\261\265\341\261\251\', transliteration: \'Tambu\', hindi: \'\340\244\244\340\244\202\340\244\254\340\245\202\', english: \'Tent\' },\n              { native: \'\341\261\251\341\261\270\341\261\264\', transliteration: \'Unt\', hindi: \'\340\244\212\340\244\201\340\244\237\', english: \'Camel\' },\n            ],\n          },\n          {\n            id: \'s2-c1-san\',\n            conceptKey: \'big_small\',\n            native: \'\341\261\242\341\261\237\341\261\250\341\261\237\341\261\235 \341\261\237\341\261\250 \341\261\240\341\261\237\341\261\271\341\261\264\341\261\244\341\261\241 (Marang ar Katij)\',\n            transliteration: \'Marang ar Katij\',\n            hindi: \'\340\244\254\340\244\241\340\244\274\340\244\276 \340\244\224\340\244\260 \340\244\233\340\245\213\340\244\237\340\244\276\',\n            english: \'Bigger and Smaller\',\n            audioPhonetic: \'Marang ar Katij. Hati do marang-a, seta do katij-a!\',\n            sceneType: \'big_small\',\n            visualHint: \'A giant elephant walks beside a tiny playful puppy, showing big vs small.\',\n            keywords: [\n              { native: \'\341\261\242\341\261\237\341\261\250\341\261\237\341\261\235\', transliteration: \'Marang\', hindi: \'\340\244\254\340\244\241\340\244\274\340\244\276\', english: \'Bigger\' },\n              { native: \'\341\261\240\341\261\237\341\261\271\341\261\264\341\261\244\341\261\241\', transliteration: \'Katij\', hindi: \'\340\244\233\340\245\213\340\244\237\340\244\276\', english: \'Smaller\' },\n              { native: \'\341\261\246\341\261\237\341\261\271\341\261\233\341\261\244\', transliteration: \'Hati\', hindi: \'\340\244\271\340\244\276\340\244\245\340\245\200\', english: \'Elephant\' },\n            ],\n          },\n          {\n            id: \'s3-c1-san\',\n            conceptKey: \'top_bottom\',\n            native: \'\341\261\252\341\261\256\341\261\233\341\261\237\341\261\261 \341\261\237\341\261\250 \341\261\236\341\261\237\341\261\233\341\261\237\341\261\250 (Chetan ar Latar)\',\n            transliteration: \'Chetan ar Latar\',\n            hindi: \'\340\244\212\340\244\252\340\244\260 \340\244\224\340\244\260 \340\244\250\340\245\200\340\244\232\340\245\207\',\n            english: \'Top and Bottom\',\n            audioPhonetic: \'Chetan ar Latar. Sarjom dare chetan re chene, latar re gari!\',\n            sceneType: \'top_bottom\',\n            visualHint: \'A colourful bird sits at the top branch of a Sal tree, while a monkey sits at the bottom.\',\n            keywords: [\n              { native: \'\341\261\252\341\261\256\341\261\233\341\261\237\341\261\261\', transliteration: \'Chetan\', hindi: \'\340\244\212\340\244\252\340\244\260\', english: \'Top\' },\n              { native: \'\341\261\236\341\261\237\341\261\233\341\261\237\341\261\250\', transliteration: \'Latar\', hindi: \'\