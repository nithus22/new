        instruction: "import { Chapter } from \'../types\';\nimport { CLASS_1_CURRICULUM } from \'./curriculumClass1\';\nimport { CLASS_2_CURRICULUM } from \'./curriculumClass2\';\nimport { CLASS_3_CURRICULUM } from \'./curriculumClass3\';\nimport { CLASS_4_CURRICULUM } from \'./curriculumClass4\';\nimport { CLASS_5_CURRICULUM } from \'./curriculumClass5\';\n\n/**\n * Official Jharkhand Council of Educational Research and Training (JCERT) Curriculum\n * for Primary Schools (Classes 1 to 5).\n * Textbooks strictly aligned with: https://jcert.jharkhand.gov.in/home/textbook\n *\n * Subject mapping:\n * - Mathematics: \340\244\260\340\245\213\340\244\232\340\244\225 \340\244\227\340\244\243\340\244\277\340\244\244 (Classes 1 to 5)\n * - Hindi: \340\244\235\340\244\277\340\244\262\340\244\256\340\244\277\340\244\262 (Classes 1 & 2), \340\244\255\340\244\276\340\244\267\340\244\276\340\244\202\340\244\234\340\244\262\340\244\277 (Classes 3, 4 & 5)\n * - English: Sunrise (Classes 1 & 2), Sunshine (Classes 3, 4 & 5)\n * - Environmental Studies (EVS): \340\244\271\340\244\256\340\244\276\340\244\260\340\245\200 \340\244\246\340\245\201\340\244\250\340\244\277\340\244\257\340\244\276 / \340\244\271\340\244\256\340\244\276\340\244\260\340\244\276 \340\244\252\340\244\260\340\244\277\340\244\265\340\245\207\340\244\266 (Classes 3, 4 & 5)\n */\nexport const INITIAL_CURRICULUM: Chapter[] = [\n  ...CLASS_1_CURRICULUM,\n  ...CLASS_2_CURRICULUM,\n  ...CLASS_3_CURRICULUM,\n  ...CLASS_4_CURRICULUM,\n  ...CLASS_5_CURRICULUM,\n];\n\nexport const SUBJECTS = [\n  {\n    id: \'maths\',\n    name: \'Mathematics\',\n    hindiName: \'\340\244\227\340\244\243\340\244\277\340\244\244 (\340\244\260\340\245\213\340\244\232\340\244\225 \340\244\227\340\244\243\340\244\277\340\244\244)\',\n    emoji: \'\360\237\223\220\',\n    bgColor: \'bg-emerald-500\',\n    color: \'#10b981\',\n    description: \'Official JCERT Textbook: \340\244\260\340\245\213\340\244\232\340\244\225 \340\244\227\340\244\243\340\244\277\340\244\244 (Classes 1 to 5)\',\n  },\n  {\n    id: \'hindi\',\n    name: \'Hindi\',\n    hindiName: \'\340\244\271\340\244\277\340\244\202\340\244\246\340\245\200 (\340\244\235\340\244\277\340\244\262\340\244\256\340\244\277\340\244\262 / \340\244\255\340\244\276\340\244\267\340\244\276\340\244\202\340\244\234\340\244\262\340\244\277)\',\n    emoji: \'\360\237\223\226\',\n    bgColor: \'bg-amber-500\',\n    color: \'#f59e0b\',\n    description: \'Official JCERT: \340\244\235\340\244\277\340\244\262\340\244\256\340\244\277\340\244\262 (Class 1-2) \342\200\242 \340\244\255\340\244\276\340\244\267\340\244\276\340\244\202\340\244\234\340\244\262\340\244\277 (Class 3-5)\',\n  },\n  {\n    id: \'english\',\n    name: \'English\',\n    hindiName: \'\340\244\205\340\244\202\340\244\227\340\245\215\340\244\260\340\245\207\340\244\234\340\245\200 (Sunrise / Sunshine)\',\n    emoji: \'\342\234\250\',\n    bgColor: \'bg-purple-500\',\n    color: \'#a855f7\',\n    description: \'Official JCERT: Sunrise (Class 1-2) \342\200\242 Sunshine (Class 3-5)\',\n  },\n  {\n    id: \'evs\',\n    name: \'EVS (\340\244\271\340\244\256\340\244\276\340\244\260\340\245\200 \340\244\246\340\245\201\340\244\250\340\244\277\340\244\257\340\244\276)\',\n    hindiName: \'\340\244\252\340\244\260\340\245\215\340\244\257\340\244\276\340\244\265\340\244\260\340\244\243 (\340\244\271\340\244\256\340\244\276\340\244\260\340\245\200 \340\244\246\340\245\201\340\244\250\340\244\277\340\244\257\340\244\276 / \340\244\271\340\244\256\340\244\276\340\244\260\340\244\276 \340\244\252\340\244\260\340\244\277\340\244\265\340\245\207\340\244\266)\',\n    emoji: \'\360\237\214\263\',\n    bgColor: \'bg-sky-500\',\n    color: \'#0ea5e9\',\n    description: \'Official JCERT: \340\244\271\340\244\256\340\244\276\340\244\260\340\245\200 \340\244\246\340\245\201\340\244\250\340\244\277\340\244\257\340\244\276 (Classes 3, 4, 5)\',\n  },\n] as const;\n\nexport interface SubjectCardInfo {\n  id: \'maths\' | \'hindi\' | \'english\' | \'evs\';\n  name: string;\n  hindiName: string;\n  bookTitle: string;\n  emoji: string;\n  bgColor: string;\n  color: string;\n  description: string;\n  chapterCount: number;\n}\n\nexport function getSubjectsForClass(classNumber: number): SubjectCardInfo[] {\n  if (classNumber <= 2) {\n    return [\n      {\n        id: \'maths\',\n        name: \'Mathematics\',\n        hindiName: `\340\244\227\340\244\243\340\244\277\340\244\244 (\340\244\260\340\245\213\340\244\232\340\244\225 \340\244\227\340\244\243\340\244\277\340\244\244 - ${classNumber})`,\n        bookTitle: `\340\244\260\340\245\213\340\244\232\340\244\225 \340\244\227\340\244\243\340\244\277\340\244\244 - ${classNumber}`,\n        emoji: \'\360\237\223\220\',\n        bgColor: \'bg-emerald-500\',\n        color: \'#10b981\',\n        description: `Official JCERT Textbook: \340\244\260\340\245\213\340\244\232\340\244\225 \340\244\227\340\244\243\340\244\277\340\244\244 - ${classNumber}`,\n        chapterCount: classNumber === 1 ? 13 : 15,\n      },\n      {\n        id: \'hindi\',\n        name: \'Hindi\',\n        hindiName: `\340\244\271\340\244\277\340\244\202\340\244\246\340\245\200 (\340\244\235\340\244\277\340\244\262\340\244\256\340\244\277\340\244\262 - ${classNumber})`,\n        bookTitle: `\340\244\235\340\244\277\340\244\262\340\244\256\340\244\277\340\244\262 - ${classNumber}`,\n        emoji: \'\360\237\223\226\',\n        bgColor: \'bg-amber-500\',\n        color: \'#f59e0b\',\n        description: `Official JCERT Textbook: \340\244\235\340\244\277\340\244\262\340\244\256\340\244\277\340\244\262 - ${classNumber}`,\n        chapterCount: classNumber === 1 ? 10 : 12,\n      },\n      {\n        id: \'english\',\n        name: \'English\',\n        hindiName: `\340\244\205\340\244\202\340\244\227\340\245\215\340\244\260\340\245\207\340\244\234\340\245\200 (Sunrise - ${classNumber})`,\n        bookTitle: `Sunrise - ${classNumber}`,\n        emoji: \'\342\234\250\',\n        bgColor: \'bg-purple-500\',\n        color: \'#a855f7\',\n        description: `Official JCERT Textbook: Sunrise - ${classNumber}`,\n        chapterCount: 11,\n      },\n    ];\n  } else {\n    const evsPart = classNumber - 2; // Class 3 -> Part 1, Class 4 -> Part 2, Class 5 -> Part 3\n    return [\n      {\n        id: \'maths\',\n        name: \'Mathematics\',\n        hindiName: `\340\244\227\340\244\243\340\244\277\340\244\244 (\340\244\260\340\245\213\340\244\232\340\244\225 \340\244\227\340\244\243\340\244\277\340\244\244 - ${classNumber})`,\n        bookTitle: `\340\244\260\340\245\213\340\244\232\340\244\225 \340\244\227\340\244\243\340\244\277\340\244\244 - ${classNumber}`,\n        emoji: \'\360\237\223\220\',\n        bgColor: \'bg-emerald-500\',\n        color: \'#10b981\',\n        description: `Official JCERT Textbook: \340\244\260\340\245\213\340\244\232\340\244\225 \340\244\227\340\244\243\340\244\277\340\244\244 - ${classNumber}`,\n        chapterCount: classNumber === 4 ? 13 : 12,\n      },\n      {\n        id: \'hindi\',\n        name: \'Hindi\',\n        hindiName: `\340\244\271\340\244\277\340\244\202\340\244\246\340\245\200 (\340\244\255\340\244\276\340\244\267\340\244\276\340\244\202\340\244\234\340\244\262\340\244\277 - ${classNumber})`,\n        bookTitle: `\340\244\255\340\244\276\340\244\267\340\244\276\340\244\202\340\244\234\340\244\262\340\244\277 - ${classNumber}`,\n        emoji: \'\360\237\223\226\',\n        bgColor: \'bg-amber-500\',\n        color: \'#f59e0b\',\n        description: `Official JCERT Textbook: \340\244\255\340\244\276\340\244\267\340\244\276\340\244\202\340\244\234\340\244\262\340\244\277 - ${classNumber}`,\n        chapterCount: classNumber === 3 ? 16 : classNumber === 4 ? 13 : 20,\n      },\n      {\n        id: \'english\',\n        name: \'English\',\n        hindiName: `\340\244\205\340\244\202\340\244\227\340\245\215\340\244\260\340\245\207\340\244\234\340\245\200 (Sunshine - ${classNumber})`,\n        bookTitle: `Sunshine - ${classNumber}`,\n        emoji: \'\342\234\250\',\n        bgColor: \'bg-purple-500\',\n        color: \'#a855f7\',\n        description: `Official JCERT Textbook: Sunshine - ${classNumber}`,\n        chapterCount: 10,\n      },\n      {\n        id: \'evs\',\n        name: \'EVS (\340\244\271\340\244\256\340\244\276\340\244\260\340\245\200 \340\244\246\340\245\201\340\244\250\340\244\277\340\244\257\340\244\276)\',\n        hindiName: `\340\244\252\340\244\260\340\245\215\340\244\257\340\244\276\340\244\265\340\244\260\340\244\243 (\340\244\271\340\244\256\340\244\276\340\244\260\340\245\200 \340\244\246\340\245\201\340\244\250\340\244\277\340\244\257\340\244\276 - ${evsPart})`,\n        bookTitle: `\340\244\271\340\244\256\340\244\276\340\244\260\340\245\200 \340\244\246\340\245\201\340\244\250\340\244\277\340\244\257\340\244\276 - ${evsPart}`,\n        emoji: \'\360\237\214\263\',\n        bgColor: \'bg-sky-500\',\n        color: \'#0ea5e9\',\n        description: `Official JCERT Textbook: \340\244\271\340\244\256\340\244\276\340\244\260\340\245\200 \340\244\246\340\245\201\340\244\250\340\244\277\340\244\257\340\244\276 - ${evsPart} (\340\244\271\340\244\256\340\244\276\340\244\260\340\244\276 \340\244\252\340\244\260\340\244\277\340\244\265\340\245\207\340\244\266)`,\n        chapterCount: classNumber === 5 ? 12 : 10,\n      },\n    ];\n  }\n}\n\nexport const CLASSES = [\n  { classNumber: 1, animal: \'Elephant (\341\261\246\341\261\237\341\261\271\341\261\233\341\261\244 / \340\244\271\340\244\276\340\244\245\340\245\200 / \340\244\271\340\244\276\340\244\244\340\245\200)\', animalEmoji: \'\360\237\220\230\', color: \'bg-emerald-500\', label: \'Class 1 / \341\261\257\341\261\251\341\261\255\341\261\236\341\261\251 \341\261\252\341\261\237\341\261\261\341\261\237\341\261\252\' },\n  { classNumber: 2, animal: \'Deer (\341\261\241\341\261\244\341\261\236 / \340\244\271\340\244\277\340\244\260\340\244\243 / \340\244\234\340\244\277\340\244\262)\', animalEmoji: \'\360\237\246\214\', color: \'bg-amber-500\', label: \'Class 2 / \341\261\253\341\261\232\341\261\245\341\261\237\341\261\250 \341\261\252\341\261\237\341\261\261\341\261\237\341\261\252\' },\n  { classNumber: 3, animal: \'Peacock (\341\261\242\341\261\237\341\261\250\341\261\237\341\261\234 / \340\244\256\340\245\213\340\244\260 / \340\244\256\340\244\276\340\244\260\340\244\276\340\244\203)\', animalEmoji: \'\360\237\246\232\', color: \'bg-sky-500\', label: \'Class 3 / \341\261\233\341\261\256\341\261\245\341\261\237\341\261\250 \341\261\252\341\261\237\341\261\261\341\261\237\341\261\252\' },\n  { classNumber: 4, animal: \'Tiger (\341\261\233\341\261\237\341\261\271\341\261\250\341\261\251\341\261\265 / \340\244\254\340\244\276\340\244\230 / \340\244\225\340\245\201\340\244\262)\', animalEmoji: \'\360\237\220\205\', color: \'bg-orange-500\', label: \'Class 4 / \341\261\257\341\261\251\341\261\261\341\261\237\341\261\234 \341\261\252\341\261\237\341\261\261\341\261\237\341\261\252\' },\n  { classNumber: 5, animal: \'Rhino / Bull (\341\261\240\341\261\237\341\261\260\341\261\237 / \340\244\227\340\245\210\340\244\202\340\244\241\340\244\276)\', animalEmoji: \'\360\237\246\217\', color: \'bg-purple-500\', label: \'Class 5 / \341\261\242\341\261\232\341\261\254\341\261\256\341\261\255\341\261\237\341\261\234 \341\261\252\341\261\237\341\261\261\341\261\237\341\261\252\' },\n];\n\nexport const STICKERS = [\n  {\n    id: \'stk-chotu\',\n    name: \'Chotu the Forest Deer\',\n    nativeNames: {\n      santali: \'\341\261\252\341\261\267\341\261\263\341\261\264\341\261\251 \341\261\241\341\261\244\341\261\236\',\n      ho: \'\360\221\242\216\360\221\243\202\360\221\243\241 \360\221\242\217\360\221\243\211\360\221\243\225\360\221\243\203\',\n      mundari: \'\340\244\233\340\245\213\340\244\237\340\245\202 \340\244\234\340\244\277\340\244\262\',\n      kurukh: \'\340\244\233\340\245\213\340\244\237\340\245\202\',\n      khortha: \'\340\244\233\340\245\213\340\244\237\340\245\202 \340\244\271\340\244\277\340\244\260\340\244\243\',\n    },\n    category: \'animals\',\n    emoji: \'\360\237\246\214\',\n    description: \'Friendly companion guide across Jharkhand forests!\',\n    unlockedAtStars: 1,\n  },\n  {\n    id: \'stk-sal-tree\',\n    name: \'Sacred Sal Tree (Sarjom)\',\n    nativeNames: {\n      santali: \'\341\261\245\341\261\237\341\261\250\341\261\241\341\261\232\341\261\242 \341\261\253\341\261\237\341\261\250\341\261\256\',\n      ho: \'\360\221\242\241\360\221\243\202\360\221\243\234\360\221\243\203 \360\221\242\267\360\221\243\234\360\221\243\216\360\221\243\211\360\221\243\255\',\n      mundari: \'\340\244\270\340\244\260\340\244\234\340\245\213\340\244\256 \340\244\246\340\244\276\340\244\260\340\245\202\',\n      kurukh: \'\340\244\270\340\244\260\340\244\234\340\245\213\340\244\256 \340\244\256\340\244\250\',\n      khortha: \'\340\244\270\340\244\226\340\245\201\340\244\206 \340\244\227\340\244\276\340\244\233\',\n    },\n    category: \'nature\',\n    emoji: \'\360\237\214\263\',\n    description: \'The state tree of Jharkhand, home of Baha parab festivals.\',\n    unlockedAtStars: 3,\n  },\n  {\n    id: \'stk-madal\',\n    name: \'Mandar / Madal Drum\',\n    nativeNames: {\n      santali: \'\341\261\264\341\261\237\341\261\242\341\261\237\341\261\240-\341\261\233\341\261\251\341\261\242\341\261\253\341\261\237\341\261\234\',\n      ho: \'\360\221\242\241\360\221\243\203\360\221\243\255\360\221\243\241\360\221\243\201 \360\221\242\241\360\221\243\202\360\221\243\214\360\221\243\201\',\n      mundari: \'\340\244\256\340\244\276\340\244\202\340\244\246\340\244\260-\340\244\260\340\245\201\340\244\244\340\245\201\',\n      kurukh: \'\340\244\256\340\244\276\340\244\202\340\244\246\340\244\260\',\n      khortha: \'\340\244\256\340\244\276\340\244\202\340\244\246\340\244\260\',\n    },\n    category: \'tribal_culture\',\n    emoji: \'\360\237\252\230\',\n    description: \'Traditional earthen drum played during Karam and Sarhul dances.\',\n    unlockedAtStars: 5,\n  },\n  {\n    id: \'stk-bow\',\n    name: \'Birsa Archer Bow (Aar-Sar)\',\n    nativeNames: {\n      santali: \'\341\261\237\341\261\234-\341\261\245\341\261\237\341\261\250\',\n      ho: \'\360\221\242\240\360\221\243\201\360\221\243\200-\360\221\242\267\360\221\243\201\360\221\243\234\',\n      mundari: \'\340\244\206-\340\244\270\340\244\276\340\244\260\',\n      kurukh: \'\340\244\225\340\244\276\340\244\260\340\245\215\340\244\254\340\245\213-\340\244\270\340\244\276\340\244\260\',\n      khortha: \'\340\244\247\340\244\250\340\245\201\340\244\267-\340\244\244\340\245\200\340\244\260\',\n    },\n    category: \'tribal_culture\',\n    emoji: \'\360\237\217\271\',\n    description: \'Symbol of courage and nature guardianship of Bhagwan Birsa Munda.\',\n    unlockedAtStars: 8,\n  },\n  {\n    id: \'stk-peacock\',\n    name: \'Sohrai Peacock\',\n    nativeNames: {\n      santali: \'\341\261\242\341\261\237\341\261\250\341\261\237\341\261\234\',\n      ho: \'\360\221\242\255\360\221\243\201\360\221\243\234\360\221\243\201\360\221\243\212 \360\221\242\217\360\221\243\202\360\221\243\235\360\221\243\211\360\221\243\200\',\n      mundari: \'\340\244\256\340\244\276\340\244\260\340\244\276\340\244\203 \340\244\232\340\245\207\340\244\202\340\244\246\340\245\213\',\n      kurukh: \'\340\244\256\340\244\234\340\244\260\340\244\276\',\n      khortha: \'\340\244\256\340\245\213\340\244\260\',\n    },\n    category: \'animals\',\n    emoji: \'\360\237\246\232\',\n    description: \'Celebrated in Hazaribagh Sohrai and Khovar mural arts.\',\n    unlockedAtStars: 10,\n  },\n];\n"
        path {
