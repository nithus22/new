        instruction: "import React, { useState } from \'react\';\nimport { Volume2, Play, Sparkles } from \'lucide-react\';\nimport { LanguageId } from \'../types\';\nimport { LANGUAGES, ACTIVE_LANGUAGES } from \'../data/languages\';\nimport { Mascot } from \'./Mascot\';\nimport { sound } from \'../utils/audio\';\n\ninterface WelcomeScreenProps {\n  onSelectLanguage: (lang: LanguageId) => void;\n  selectedLanguage: LanguageId;\n}\n\nexport const WelcomeScreen: React.FC<WelcomeScreenProps> = ({\n  onSelectLanguage,\n  selectedLanguage,\n}) => {\n  const [playingAudioLang, setPlayingAudioLang] = useState<LanguageId | null>(null);\n\n  const playGreetingAudio = (e: React.MouseEvent, langId: LanguageId) => {\n    e.stopPropagation();\n    sound.playPop();\n    setPlayingAudioLang(langId);\n    const config = LANGUAGES[langId];\n\n    sound.speakText(config.audioGreetingPhonetic, {\n      lang: \'hi-IN\',\n      rate: 0.85,\n      pitch: 1.15,\n      onEnd: () => setPlayingAudioLang(null),\n    });\n  };\n\n  const handleLanguagePick = (langId: LanguageId) => {\n    sound.playCorrect();\n    onSelectLanguage(langId);\n  };\n\n  return (\n    <div className=\"min-h-[calc(100vh-68px)] flex flex-col justify-between py-6 px-4 max-w-5xl mx-auto\">\n      {/* Top Banner & Mascot Welcome */}\n      <div className=\"text-center space-y-4\">\n        {/* Floating Clouds & Trees Background accents */}\n        <div className=\"flex justify-center items-center gap-2\">\n          <span className=\"text-2xl animate-bounce\">\360\237\214\262</span>\n          <span className=\"bg-amber-200 text-amber-900 text-xs sm:text-sm font-extrabold px-3 py-1 rounded-full border-2 border-amber-400 inline-flex items-center gap-1.5 shadow-sm\">\n            <span>\360\237\214\276</span> Jharkhand Primary Education (JCERT Classes 1 to 5)\n          </span>\n          <span className=\"text-2xl animate-bounce\" style={{ animationDelay: \'0.3s\' }}>\360\237\214\262</span>\n        </div>\n\n        <div className=\"flex flex-col items-center justify-center my-2\">\n          <Mascot\n            speechText=\"\341\261\241\341\261\232\341\261\246\341\261\237\341\261\250! / \360\221\242\271\360\221\243\211\360\221\243\200 \360\221\243\216\360\221\243\213\360\221\243\234 / \340\244\234\340\245\213\340\244\271\340\244\276\340\244\260! Welcome to Bhasha Setu!\"\n            speechTransliteration=\"\341\261\237\341\261\242\341\261\237\341\261\234 \341\261\257\341\261\237\341\261\271\341\261\250\341\261\245\341\261\244 \341\261\265\341\261\237\341\261\252\341\261\267\341\261\237\341\261\243 \341\261\242\341\261\256! \342\200\242 \340\244\205\340\244\252\340\244\250\340\245\200 \340\244\256\340\244\276\340\244\244\340\245\203\340\244\255\340\244\276\340\244\267\340\244\276 \340\244\232\340\245\201\340\244\250\340\245\213!\"\n            size=\"lg\"\n            audioSpeechText=\"Johar! Which is your language? Am chet bhasha te parha-am?\"\n          />\n        </div>\n\n        <div className=\"space-y-1\">\n          <h2 className=\"text-2xl sm:text-4xl font-black text-amber-950 tracking-tight\">\n            Which is your language?\n          </h2>\n          <p className=\"text-base sm:text-lg text-amber-800 font-bold\">\n            <span className=\"font-olchiki\">\341\261\237\341\261\242\341\261\237\341\261\234 \341\261\257\341\261\237\341\261\271\341\261\250\341\261\245\341\261\244 \341\261\232\341\261\240\341\261\237 \341\261\240\341\261\237\341\261\261\341\261\237?</span> \342\200\242 <span className=\"font-warangchiti\">\360\221\242\240\360\221\243\255\360\221\243\201\360\221\243\200 \360\221\242\241\360\221\243\202\360\221\243\214\360\221\243\202 \360\221\242\217\360\221\243\202\360\221\243\235\360\221\243\201?</span> \342\200\242 <span className=\"font-devanagari\">\340\244\206\340\244\256\340\244\276\340\244\203 \340\244\252\340\244\276\340\244\260\340\244\270\340\245\200 \340\244\223\340\244\225\340\245\213\340\244\257\340\244\276?</span>\n          </p>\n        </div>\n      </div>\n\n      {/* 3 Main Mother Tongue Choices */}\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6 my-6\">\n        {ACTIVE_LANGUAGES.map((lang) => {\n          const isSelected = selectedLanguage === lang.id;\n          const isAudioPlaying = playingAudioLang === lang.id;\n\n          return (\n            <div\n              key={lang.id}\n              onClick={() => handleLanguagePick(lang.id)}\n              className={`relative group rounded-3xl p-5 sm:p-6 transition-all duration-200 cursor-pointer border-4 shadow-xl press-bounce flex flex-col justify-between ${\n                isSelected\n                  ? \'border-amber-500 bg-white ring-4 ring-amber-300 scale-102\'\n                  : \'border-amber-300 bg-white/90 hover:bg-white hover:border-amber-400 hover:shadow-2xl\'\n              }`}\n              style={{\n                background: `linear-gradient(to bottom, white, ${lang.bgColor})`,\n              }}\n              role=\"button\"\n              tabIndex={0}\n              aria-label={`Select ${lang.name} language`}\n            >\n              {/* Top Accent Icon & Audio Button */}\n              <div className=\"flex items-start justify-between\">\n                <div className=\"w-14 h-14 rounded-2xl bg-white shadow-md border-2 border-amber-300 flex items-center justify-center text-3xl group-hover:scale-110 transition-transform\">\n                  {lang.iconEmoji}\n                </div>\n\n                <button\n                  onClick={(e) => playGreetingAudio(e, lang.id)}\n                  className={`p-2.5 rounded-2xl border-2 transition-all shadow-sm ${\n                    isAudioPlaying\n                      ? \'bg-amber-500 text-white border-amber-600 animate-pulse\'\n                      : \'bg-white hover:bg-amber-100 text-amber-900 border-amber-300\'\n                  }`}\n                  title={`Listen to greeting in ${lang.name}`}\n                  aria-label={`Listen to ${lang.name} audio greeting`}\n                >\n                  <Volume2 className=\"w-5 h-5\" />\n                </button>\n              </div>\n\n              {/* Language Name and Native Script */}\n              <div className=\"my-4 space-y-1\">\n                <span className=\"text-xs uppercase font-extrabold tracking-wider px-2 py-0.5 rounded-md bg-white/80 border border-amber-200 text-amber-800\">\n                  {lang.scriptName}\n                </span>\n\n                <h3\n                  className={`text-3xl sm:text-4xl font-extrabold tracking-tight mt-1 text-slate-900 ${lang.fontClass}`}\n                >\n                  {lang.nativeName}\n                </h3>\n                {lang.alternateNative && (\n                  <p className=\"text-sm font-semibold text-slate-600\">\n                    {lang.alternateNative}\n                  </p>\n                )}\n\n                <p className=\"text-lg font-black text-amber-950 mt-1\">\n                  {lang.name}\n                </p>\n\n                <p className=\"text-xs text-slate-600 font-medium\">\n                  {lang.description}\n                </p>\n              </div>\n\n              {/* Greeting Sample */}\n              <div className=\"bg-white/80 rounded-2xl p-2.5 border border-amber-200 mt-2 text-center\">\n                <p className={`text-sm font-bold text-amber-900 ${lang.fontClass}`}>\n                  {lang.greetingText}\n                </p>\n                <p className=\"text-[11px] text-amber-700 font-semibold mt-0.5\">\n                  {lang.greetingTransliteration}\n                </p>\n              </div>\n\n              {/* Action Big Button */}\n              <div className=\"mt-4 pt-2 border-t border-amber-200\">\n                <div\n                  className={`w-full py-2.5 px-4 rounded-2xl font-black text-center text-sm sm:text-base flex items-center justify-center gap-2 shadow-md transition-all ${\n                  