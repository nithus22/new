      url: "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQEIIwRMWNQdSJhht7QFabhiaYCbnBl59zh0BSbsihKTnCyAiyZC5Vhd_sHSZosIQjo2IAimVzrjtpk5f6LF4Axd7dnuIV2v9ri7g7xN-DgQc_tFpZfiyLHgbsUVMLvCefY54EZD7yMFcQtOS9zNu9FPg4rZ"
