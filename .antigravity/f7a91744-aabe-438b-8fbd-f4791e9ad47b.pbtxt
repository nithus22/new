        instruction: "import { Chapter } from \'../types\';\n\nexport const CLASS_2_CURRICULUM: Chapter[] = [\n  // =========================================================================\n  // CLASS 2 - MATHEMATICS: \"\340\244\260\340\245\213\340\244\232\340\244\225 \340\244\227\340\244\243\340\244\277\340\244\244 - 2 (JCERT Class 2)\"\n  // =========================================================================\n  {\n    id: \'c2-maths-ch1\',\n    chapterNumber: 1,\n    classNumber: 2,\n    subjectId: \'maths\',\n    bookName: \'\340\244\260\340\245\213\340\244\232\340\244\225 \340\244\227\340\244\243\340\244\277\340\244\244 - 2 (JCERT Class 2)\',\n    originalTitleHindi: \'\340\244\225\340\245\215\340\244\257\340\244\276 \340\244\271\340\245\210 \340\244\262\340\244\202\340\244\254\340\244\276, \340\244\225\340\245\215\340\244\257\340\244\276 \340\244\271\340\245\210 \340\244\227\340\245\213\340\244\262?\',\n    originalTitleEnglish: \'What is Long, What is Round?\',\n    coverEmoji: \'\360\237\223\217\',\n    languages: {\n      santali: { title: \'\341\261\252\341\261\256\341\261\253 \341\261\240\341\261\237\341\261\261\341\261\237 \341\261\241\341\261\244\341\261\236\341\261\244\341\261\247, \341\261\252\341\261\256\341\261\253 \341\261\240\341\261\237\341\261\261\341\261\237 \341\261\234\341\261\251\341\261\236\341\261\237\341\261\271\341\261\264? (Chet kana Jiling, Chet kana Gulat?)\', scriptText: \'\341\261\252\341\261\256\341\261\253 \341\261\240\341\261\237\341\261\261\341\261\237 \341\261\241\341\261\244\341\261\236\341\261\244\341\261\247, \341\261\252\341\261\256\341\261\253 \341\261\240\341\261\237\341\261\261\341\261\237 \341\261\234\341\261\251\341\261\236\341\261\237\341\261\271\341\261\264?\', transliteration: \'Chet kana Jiling, Chet kana Gulat?\', reviewStatus: \'approved\', lessonSlides: [] },\n      ho: { title: \'\360\221\242\261\360\221\243\202\360\221\243\223\360\221\243\201 \360\221\242\216\360\221\243\202\360\221\243\237\360\221\243\2