| \'big\' | \'small\' | \'top\' | \'bottom\' | \'rolling\' | \'sliding\';\n}\n\nexport interface ChapterGameData {\n  dragDrop?: {\n    instruction: {\n      native: string;\n      transliteration: string;\n      hindi: string;\n      english: string;\n    };\n    zones: Array<{\n      id: string;\n      label: {\n        native: string;\n        transliteration: string;\n        hindi: string;\n        english: string;\n      };\n      color: string;\n    }>;\n    items: DragItem[];\n  };\n  matching?: {\n    instruction: {\n      native: string;\n      transliteration: string;\n      hindi: string;\n      english: string;\n    };\n    pairs: Array<{\n      id: string;\n      emoji: string;\n      nativeWord: string;\n      transliteration: string;\n      hindiWord: string;\n    }>;\n  };\n  counting?: {\n    instruction: {\n      native: string;\n      transliteration: string;\n      hindi: string;\n      english: string;\n    };\n    items: Array<{\n      id: string;\n      emoji: string;\n      name: string;\n      count: number;\n    }>;\n  };\n  tracing?: {\n    letter: string;\n    letterName: string;\n    script: ScriptMode;\n    sound: string;\n    strokeGuide: string;\n  };\n  quiz?: Array<{\n    id: string;\n    question: {\n      native: string;\n      transliteration: string;\n      hindi: string;\n      english: string;\n    };\n    options: Array<{\n      id: string;\n      text: string;\n      emoji?: string;\n      isCorrect: boolean;\n    }>;\n    explanation: string;\n  }>;\n}\n\nexport interface Chapter {\n  id: string;\n  chapterNumber: number;\n  classNumber: number; // 1 to 5\n  subjectId: \'maths\' | \'hindi\' | \'evs\' | \'english\';\n  bookName: string;\n  originalTitleHindi: string;\n  originalTitleEnglish: string;\n  coverEmoji: string;\n  languages: {\n    santali: ChapterTranslation;\n    ho: ChapterTranslation;\n    mundari: ChapterTranslation;\n    [key: string]: ChapterTranslation;\n  };\n}\n\nexport interface UserProgress {\n  selectedLanguage: LanguageId;\n  activeScript: ScriptMode;\n  selectedClass: number;\n  starsEarned: number;\n  completedChapters: string[]; // chapter ids\n  unlockedStickers: string[]; // sticker ids\n  soundEnabled: boolean;\n  highContrast: boolean;\n  reduceMotion: boolean;\n  speechRate: number;\n}\n\nexport interface TranslationFeedback {\n  id: string;\n  chapterId: string;\n  chapterTitle: string;\n  language: LanguageId;\n  problemType: \'spelling\' | \'wrong_word\' | \'script_display\' | \'audio_missing\' | \'other\';\n  suggestedCorrection: string;\n  reporterRole: \'student\' | \'teacher\' | \'parent\';\n  timestamp: string;\n  status: \'pending\' | \'resolved\';\n}\n\nexport interface Sticker {\n  id: string;\n  name: string;\n  nativeNames: Record<LanguageId, string>;\n  category: \'animals\' | \'nature\' | \'tribal_culture\' | \'stars\';\n  emoji: string;\n  description: string;\n  unlockedAtStars: number;\n}\n"
